/*
    SesiDo Safe File Access
    File operations wrapped in try-catch blocks to prevent crashes
*/
allow "std/time" in as Time

export fn makeDir(path: str) {make_dir(path)}
export fn readFile(path: str) -> str? {
    let result = ""
    let success = false
    let attempts = 0
    while !success && attempts < 3 {
        try {
            result = read_file(path)
            success = true
        } catch (err) {
      let errText = str(err)
      // Missing files are expected in some flows (e.g., first append to a new log).
      if contains(errText, "ENOENT") {
        return ""
      }
      show "[SesiDo]: Failed to read file at:" path
      show "Details:" err
            attempts = attempts + 1
            Time.sleep(100)
        }
    }
    return result
}
export fn writeFile(path: str, content: str) -> bool {
    let success = false
    let attempts = 0
    while !success && attempts < 3 {
        try {
            write_file(path, content)
            success = true
        } catch (err) {
            show "[SesiDo]: Failed to write to file at:" path
            show "Details:" err
            attempts = attempts + 1
            Time.sleep(100)
        }
    }
    return success
}
export fn writeImage(path: str, content: str) -> bool {
    let success = false
    let attempts = 0
    while !success && attempts < 3 {
        try {
        write_image(path, content)
        success = true
        } catch (err) {
            show "[SesiDo]: Failed to write image to file at:" path
            show "Details:" err
            attempts = attempts + 1
            Time.sleep(100)
        }
    }
    return success
}
export fn appendFile(path: str, content: str) -> bool {
  let success = false
  let attempts = 0
  while !success && attempts < 3 {
    try {
      append_file(path, content)
      success = true
    } catch (err) {
        show "[SesiDo]: Failed to append to file at:" path
        show "Details:" err
        attempts = attempts + 1
        Time.sleep(100)
    }
  }
  return success
}
export fn moveFile(path: str, dest: str) -> bool {
  let success = false
  let attempts = 0
  while !success && attempts < 3 {
    try {
      rename(path, dest)
      success = true
    } catch (err) {
      show "[SesiDo]: Failed to move file at:" path
      show "Details:" err
      attempts = attempts + 1
      Time.sleep(100)
    }
  }
  return success
}

// Get working directory
let currentOS = trim(js("console.log(require('os').platform())"))
let pwd = ""

if currentOS == "linux" || currentOS == "darwin" {
  try {pwd = env("PWD")} catch (e) {}
  if contains(pwd, "/") {
    pwd = trim(pwd) + "/" // Normalize the working directory for Linux and macOS
  }
}

if currentOS == "win32" {
  try {pwd = exec("cd")} catch (e) {}
  if includes(pwd, "\\") {
    let parts = split(pwd, "\n")
    let finalPath = parts[0]
    pwd = trim(swap(finalPath, "\\", "/")) + "/" // Normalize the working directory for Windows
  }
}

export let wsRoot = pwd