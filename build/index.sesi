// SesiDo Engine
// Imports
allow "std/db" in with DB; allow "std/browser" in with{launch}; allow "../agent/persona" in with Persona; allow "../agent/ledger/evidence" in with Evidence; allow "../agent/ledger/pixel-grid" in with PixelGrid; allow "../utils/safe" in with Safe; allow "../helpers/timestamp" in with{localTime, universalTime, formattedTime}
// Variables
let workspaceRoot = Safe.wsRoot+"SesiDo/"; let dbDir=workspaceRoot+"database/"; let artifactsDir=workspaceRoot+".artifacts/"; let logsDir=workspaceRoot+"logs/"; let codeDir=artifactsDir+"code/"; let imageDir=artifactsDir+"images/"; let svgDir=artifactsDir+"svgs/"; let summaryDir=artifactsDir+"summaries/"; let researchDir=artifactsDir+"research/"; let browserDir=artifactsDir+"browser/"
// Make sure directories exist
make_dir(dbDir); make_dir(dbDir+".agent/"); make_dir(artifactsDir); make_dir(logsDir); make_dir(codeDir); make_dir(imageDir); make_dir(svgDir); make_dir(summaryDir); make_dir(researchDir); make_dir(browserDir)
// Database
let db=DB.db_open(dbDir+"agent.db", "enter-your-super-secret-password-here"); let history=db.collection("history"); let sessions=db.collection("sessions"); let sessionLogPath=""
// Current session ID and timestamps
export let currentSessionId="default"; export let localTime=localTime("basic"); export let universalTime=universalTime(); export let formattedTime=formattedTime()
// System instructions, tools, and persona
let hasGPT = false; if !is_null(env("OPENAI_API_KEY")){hasGPT = true}
let instructions=Persona.getSystemInstruction(); let toolsMD=Persona.getToolsMD(); let agentBasicsMD=Persona.getAgentBasicsMD(); let agentOptionalMD=Persona.getAgentOptionalMD(); let agentOtherMD=Persona.getAgentOtherMD(); let agentTools=Persona.getAgentTools()
make AgentVoice{let voiceOn=false; fn start(self){self.voiceOn=false} fn toggle(self){if self.voiceOn{self.voiceOn=false; print "[SesiDo]: Voice mode disabled."}else{self.voiceOn=true; print "[SesiDo]: Voice mode enabled."; speech("Hello, I am Sey-see Do, your AI agent. How can I assist you today?")}} fn response(self, message){if self.voiceOn{speech(message)}}}let agentVoice=AgentVoice()
export let sesiDoModels = ["SesiDo", "SesiDo-Heavy", "SesiDo-Pro", "SesiDo-Lite", "SesiDo-Lite-Power", "SesiDo-Flash", "SesiDo-Image", "SesiDo-Image-Lite", "SesiDo-GPT", "SesiDo-GPT-Pro", "SesiDo-GPT-Lite", "SesiDo-GPT-Image"]; export let ogNames = ["gemini-3.6-flash", "gemini-3.5-flash", "gemini-3.1-pro-preview", "gemini-3.1-flash-lite", "gemini-3.5-flash-lite", "gemini-3-flash-preview", "gemini-3.1-flash-image", "gemini-3.1-flash-lite-image", "gpt-5.6-terra", "gpt-5.6-sol", "gpt-5.6-luna", "gpt-image-2"]
fn setModel(alias: str, model_name: str){if alias!=null{set_alias(alias, model_name)}else{set_alias(sesiDoModels[0], ogNames[0]); set_alias(sesiDoModels[1], ogNames[1]); set_alias(sesiDoModels[2], ogNames[2]); set_alias(sesiDoModels[3], ogNames[3]); set_alias(sesiDoModels[4], ogNames[4]); set_alias(sesiDoModels[5], ogNames[5]); set_alias(sesiDoModels[6], ogNames[6]); set_alias(sesiDoModels[7], ogNames[7]); set_alias(sesiDoModels[8], ogNames[8]); set_alias(sesiDoModels[9], ogNames[9]); set_alias(sesiDoModels[10], ogNames[10]); set_alias(sesiDoModels[11], ogNames[11])}}
// Temperature and thinking level settings
export let minimalTemp=0.1; export let lowTemp=0.3; export let mediumTemp=0.5; export let highTemp=0.7; export let minimalThink="minimal"; export let lowThink="low"; export let mediumThink="medium"; export let highThink="high"; export let streamOutput=true; export let searchGoogle=true; export let square="1:1"; export let portrait="9:16"; export let landscape="16:9"; export let tv="4:3"; export let mini="512"; export let small="1K"; export let medium="2K"; export let large="4K"
// Base brain from persona
fn get_base_brain(){prompt base_brain{"systemInstructions:" instructions "\ntoolsMD:" toolsMD "\nSesi Basics:" agentBasicsMD "\nSesi Optional:" agentOptionalMD "\nSesi Other:" agentOtherMD "\nAgent Tools:" agentTools "\nNote: The '" artifactsDir "' directory and its subdirectories already exists. Use it to save generated assets. Do not try to create it, only adding new subdirecties to it."} return base_brain}
let brain=get_base_brain()
// Load existing session or create new one
setModel()
fn loadSession(sid){currentSessionId=sid; let sessionDir=logsDir+sid+"/"; make_dir(sessionDir); sessionLogPath=sessionDir+"agent-"+formattedTime+".log"; let prevMessages=history.find({"sessionId":sid});let conversation=""; for msg in prevMessages{conversation=conversation+msg["role"]+":"+msg["content"]+"; "}let jsonRep={"stable_facts":[], "user_preferences":[], "project_state":[], "agent_identity":[], "style_preferences":[], "metaphors":[], "discard":[]}; let brainJson=model("SesiDo-Lite-Power"){"Summarize the durable memory from this conversation. Rules:\n- Keep only stable facts, user preferences, project identity, unresolved tasks, agent identity, style preferences, and useful metaphors.\n- agent_identity must contain only literal operational facts and boundaries.\n- Do not include metaphors in agent_identity. Put all figurative descriptions only in metaphors.\n- Do not preserve poetic phrasing unless explicitly labeled as style or metaphor.\n- Label metaphors as metaphors, not facts.\n- Put hallucinations, temporary task details, stale claims, unsupported claims, old names, and conversational filler in discard. Conversation:" conversation "\nReturn a JSON object with the following keys:\n" jsonRep}; let clean=swap(brainJson, "```json", ""); clean=swap(clean, "```", ""); brainJson=clean; let brainSummary=structured_output({stable_facts:str, user_preferences:str, project_state:str, agent_identity:str, style_preferences:str, metaphors:str, discard:str})(brainJson); print "[SesiDo]: Loaded session '" sid "' with " str(len(prevMessages))" previous messages."; let memoryBlock="SESSION MEMORY:\n\nStable facts: "+brainSummary["stable_facts"]+" User preferences: "+brainSummary["user_preferences"]+" Project state: "+brainSummary["project_state"]+" Agent identity: "+brainSummary["agent_identity"]+" Style preferences: "+brainSummary["style_preferences"]+" Metaphors: "+brainSummary["metaphors"]+"\n\nRules:\n- Metaphors are optional style references, not factual claims. Do not use them in ordinary greetings unless the user asks for expressive or philosophical language.\n- Do not mention the session memory to the user unless they ask about it.\n- Do not mention your tools or capabilities to the user unless they ask about them.\n- Focus on the user's goals and requests, and use your tools to assist them if required."; let fileAppend = null; fileAppend = Safe.appendFile(dbDir+".agent/"+sid+"-memory-block.md", memoryBlock+"\n-----\n"); if is_null(fileAppend) {fileAppend = Safe.writeFile(dbDir+".agent/"+sid+"-memory-block.md", memoryBlock+"\n-----\n")} brain=brain+memoryBlock; let existing=sessions.find({"id":sid}); if len(existing)==0{sessions.insert({"id":sid, "created":universalTime})}}
loadSession("default")
// String manipulation
fn quote(s){let text=str(s); text=swap(text, "\"", "\\\""); return "\""+text+"\""}
fn sanitize(name){let s=str(name); s=swap(s, "\n", ""); s=swap(s, " ", "_"); s=swap(s, "/", "-"); s=swap(s, "{", ""); s=swap(s, "}", ""); s=swap(s, ":", ""); s=swap(s, "\"", ""); s=swap(s, "'", ""); s=swap(s, "?", ""); s=swap(s, "*", ""); s=swap(s, "<", ""); s=swap(s, ">", ""); s=swap(s, "|", ""); if len(s)>40{s=slice(s, 0, 40)}return s}
let activeLedger=Evidence.newLedger(); let activeRequirements=Evidence.requirementsFor(""); let repeatSignature=""; let repeatObservation=null; let repeatCount=0
fn resetEvidence(request){activeLedger=Evidence.newLedger(); activeRequirements=Evidence.requirementsFor(request); repeatSignature=""; repeatObservation=null; repeatCount=0}
fn evidencePreflight(request, tool_name, tool_args){let signature=tool_name+"|"+to_json(tool_args); if signature==repeatSignature&&repeatCount>=1{return "Error: Repeated no-information call blocked after two attempts. Reassess the target or use an independent check."}if Evidence.shouldBlockMutation(request, activeLedger, tool_name){return "Error: Reproduce-before-patching protocol blocked this mutation. Run the failing target and capture its concrete error first."}return ""}
fn recordEvidence(tool_name, tool_args, observation){let signature=tool_name+"|"+to_json(tool_args); if signature==repeatSignature&&Evidence.noNewInformation(repeatObservation, observation){repeatCount=repeatCount+1}else{repeatCount=0}repeatSignature=signature; repeatObservation=observation; activeLedger=Evidence.observe(activeLedger, tool_name, observation)}
fn guardEvidence(answer){return Evidence.guardFinal(answer, activeLedger, activeRequirements)}
// File system operations
fn newDir(args){let path=null; if type(args)=="object"{path=args["path"]}else{path=args}if path==null{return "Error: makeDir requires a path."}try{Safe.makeDir(path); return "Success: Directory created: "+path}catch(e){return "Error creating directory:"+str(e)}}
fn read(args){let path=null; if type(args)=="object"{path=args["path"]}else{path=args}if path==null{return "Error: read requires a path."}let userInput=input("SesiDo Agent is trying to read file "+path+". Is this okay?: (y/n) "); if to_lower(trim(userInput))!="y"{return "Error: User rejected read request."} if to_lower(trim(userInput))=="y"{try{let content=Safe.readFile(path); if content!=null{return content}}catch(e){}return null}}
fn write(args){let path=null; let content=null; if type(args)=="object"{path=args["path"]; content=args["content"]}if path==null||content==null{return "Error: write requires path and content."}let userInput=input("SesiDo Agent is trying to write to file "+path+". Is this okay?: (y/n) "); if to_lower(trim(userInput))!="y"{return "Error: User rejected write request."} if to_lower(trim(userInput))=="y"{try{Safe.writeFile(path, content); return "Success: Wrote to "+path}catch(e){return "Error writing file:"+str(e)}}}
fn remove(args){let path=null; if type(args)=="object"{path=args["path"]}else{path=args}if path==null{return "Error: remove requires a path."}let userInput=input("SesiDo Agent is trying to remove file "+path+". Is this okay?: (y/n) "); if to_lower(trim(userInput))!="y"{return "Error: User rejected remove request."}if to_lower(trim(userInput))=="y"{prompt success{"Successfully removed "path}; prompt error{"Error removing "path}try {trash(path, false); return success}catch(e){return error+str(e)}}}
fn move(args){let path=null; let dest=null; if type(args)=="object"{path=args["path"]; dest=args["destination"]}else if type(args)=="array"{path=args[0]; dest=args[1]}else{path=args}if path==null||dest==null{return "Error: move requires a source and destination."}let userInput=input("SesiDo Agent is trying to move "+path+" to "+dest+". Is this okay?: (y/n) "); if to_lower(trim(userInput))!="y"{return "Error: User rejected move request."}if to_lower(trim(userInput))=="y"{try{Safe.moveFile(path, dest); return "Success: Moved "+path+" to "+dest}catch(e){return "Error moving file:"+str(e)}}}
fn list(args){let path=Safe.wsRoot; if type(args)=="object"{if args["path"]!=null{path=args["path"]}}else if args!=null{path=args}try{let files=list_dir(path); return files}catch(e){return "Error listing directory:"+str(e)}}
fn appendTo(args){let path=null; let content=null; if type(args)=="object"{path=args["path"]; content=args["content"]}if path==null||content==null{return "Error: appendFile requires path and content."}try{Safe.appendFile(path, content); return "Success: Appended to "+path}catch(e){return "Error appending to file:"+str(e)}}
fn runSesi(args){let path=null; if type(args)=="object"{path=args["path"]}else{path=args}if path==null||path==""{return "Error: runSesi requires a path."}if len(path)<5||slice(to_lower(path), len(path)-5, len(path))!=".sesi"{return "Error: runSesi accepts only a .sesi script path."}let userInput=input("SesiDo Agent is trying to run Sesi script: "+path+". Is this okay?: (y/n) "); if to_lower(trim(userInput))!="y"{return "Error: User rejected run request."}try{let output=sesi(path, true); return "Success: runSesi executed "+path+".\n"+str(output)}catch(e){return "Execution error:"+str(e)}}
fn safeRun(args){let cmd=null; if type(args)=="object"{cmd=args["command"]; if cmd==null{cmd=args["cmd"]}}else{cmd=args}if cmd==null{return "Error: safeRun requires a command."}let userInput=input("SesiDo Agent is trying to run command: "+cmd+". Is this okay?: (y/n) "); if to_lower(trim(userInput))!="y"{return "Error: User rejected run request."}if to_lower(trim(userInput))=="y"{let output=cmd; try{output=exec(cmd); return output}catch(e){return "Execution error:"+str(e)}}}
fn eval(args){let code=null; if type(args)=="object"{code=args["code"]}else{code=args}if code==null{return "Error: eval requires code."}let userInput = input("SesiDo Agent is trying to eval code: "+code+". Is this okay?: (y/n) "); if to_lower(trim(userInput))!="y"{return "Error: User rejected eval request."}if to_lower(trim(userInput))=="y"{try{let tempFile = "sesido-temp-eval.sesi"; Safe.writeFile(tempFile, code); let result=sesi(tempFile, true); trash(tempFile, true); return result}catch(e){return "Error evaluating code: "+str(e)}}}
fn httpGet(args){let url=null; let headers={}; if type(args)=="object"{url=args["url"]; if args["headers"]!=null{headers=args["headers"]}}else{url=args}if url==null{return "Error: httpGet requires a URL."}try{let response=web_get(url, headers); return response}catch(e){return "HTTP GET error:"+str(e)}}
fn httpSend(args){let url=null; let data=null; let headers={}; if type(args)=="object"{url=args["url"]; data=args["data"]; if args["headers"]!=null{headers=args["headers"]}}if url==null{return "Error: httpSend requires a URL."}try{let response=web_send(url, data, headers); return response}catch(e){return "HTTP SEND error:"+str(e)}}
// SesiDo Agents
export fn writeCode(args){let query=null; if type(args)=="object"{if args["query"]!=null{query=args["query"]}else if args["text"]!=null{query=args["text"]}else if args["description"]!=null{query=args["description"]}}else{query=args}if(query==null||query=="")&&type(args)=="object"&&len(keys(args))==1{let firstKey=keys(args)[0]; query=args[firstKey]}if query==null||query==""{return "Error: writeCode requires a query or request description."}print "[SesiDo]: Writing code for:" query; let codeResponse=""; try{codeResponse=model("SesiDo-Pro"){thinkingLevel: mediumThink, temperature: lowTemp, system: brain}{"Write code for the following request (avoid verbatim recitation of large standard texts; paraphrase or draft custom versions if needed): " query}}catch(e){print "[SesiDo]: ⚠ Code generation failed(" str(e)"). Trying SesiDo-Flash..."; try{codeResponse=model("SesiDo-Flash"){thinkingLevel: mediumThink, temperature: mediumTemp, system: brain}{"Write code for: " query}}catch(e2){return "Code generation failed due to safety or technical blocks."}}let filename=codeDir+sanitize(query)+"-"+formattedTime+"-code.md"; Safe.writeFile(filename, codeResponse); print "[SesiDo]: Wrote code for" query "and saved to" codeDir "!"; return codeResponse}
export fn debugCode(args){let targetFile=null; let query=null; if type(args)=="object"{if args["path"]!=null{targetFile=args["path"]}else if args["file"]!=null{targetFile=args["file"]}else if args["query"]!=null{query=args["query"]}}else{query=args}if targetFile==null&&query==null{print "[SesiDo]:Enter the path to the code file you want to debug..." targetFile=input("[You]: ")}else if targetFile==null&&query!=null{let words=split(query, " "); for w in words{if contains(w, ".")&&!contains(w, "search"){targetFile=w}}}if targetFile==null{return "No file specified for debugging."}let codeContent=Safe.readFile(targetFile); if codeContent==null{return "Failed to read file."}print "[SesiDo]: Debugging code in file:" targetFile; let preCode=model("SesiDo-Pro"){temperature: lowTemp, system: brain}{"Debug the following code and provide suggestions for improvements or fixes:" codeContent}; Safe.writeFile(codeDir+sanitize(targetFile)+"-"+formattedTime+"-pre-debug.md", preCode); let debugResponse=model("SesiDo-Lite"){temperature: mediumTemp}{brain " Apply the following debugging suggestions to the code in " targetFile " and provide the improved code:" preCode}; Safe.writeFile(codeDir+sanitize(targetFile)+"-"+formattedTime+"-debug.md", debugResponse); print "[SesiDo]: Debugged code in" targetFile "and saved results to" codeDir "!"; return debugResponse}
export fn research(args){let query=null; if type(args)=="object"{if args["query"]!=null{query=args["query"]}else if args["topic"]!=null{query=args["topic"]}}else{query=args}if query==null||query==""{return "Error: research requires a query."}print "[SesiDo]: Conducting research on:" query; let researchResponse=""; try{researchResponse=model("SesiDo-Lite-Power"){thinkingLevel: mediumThink, search, system: brain}{"Research the following topic and provide a summary of findings (paraphrase sources to avoid recitation blocks) Must return:\n- sources_used: list of URLs or document paths\n- claims: 3 to 7 key claims\n- confidence: low|medium|high\n- unsupported/speculative claims: list\n- synthesis: final prose " query}}catch(e){print "[SesiDo]: ⚠ Research failed(" str(e)"). Retrying with SesiDo-Lite..."; try{researchResponse=model("SesiDo-Lite"){thinkingLevel: lowThink, temperature: lowTemp}{"Research:" query}}catch(e2){return "Research failed due to safety or technical blocks."}}let filename=researchDir+sanitize(query)+"-"+formattedTime+"-research.md"; Safe.writeFile(filename, researchResponse); print "[SesiDo]: Research completed on" query "and saved results to" researchDir "!"; return researchResponse}
export fn summarize(args){let text=null; if type(args)=="object"{if args["text"]!=null{text=args["text"]}else if args["path"]!=null{text=args["path"]}else if args["query"]!=null{text=args["query"]}}else{text=args}if text==null||text==""{return "Error: summarize requires text or a file path."}let query=text; if text==null||text==""{return "No text provided for summarization."}if len(text)<100&&contains(text, "."){let content=Safe.readFile(text); if content!=null{text=content}}print "[SesiDo]: Summarizing..."; let summaryResponse=""; try{summaryResponse=model("SesiDo-Lite-Power"){thinkingLevel: mediumThink, temperature: lowTemp, max_tokens: 1024, system: brain}{"Summarize the following text:" text}}catch(e){print "[SesiDo]: ⚠ Summarization failed(" str(e)"). Retrying with SesiDo-Lite..."; try{summaryResponse=model("SesiDo-Lite"){thinkingLevel: minimalThink, temperature: lowTemp}{"Summarize:" text}}catch(e2){return "Summarization failed due to safety or technical blocks."}}let filename=summaryDir+sanitize(query)+"-"+formattedTime+"-summary.md"; Safe.writeFile(filename, summaryResponse); print "[SesiDo]: Summarized text and saved summary to" summaryDir "!"; return summaryResponse}
export fn calculator(args){let expression=null; if type(args)=="object"{if args["expression"]!=null{expression=args["expression"]}else if args["query"]!=null{expression=args["query"]}}else{expression=args}if expression==null||expression==""{return "Error: calculator requires a mathematical expression."}print "[SesiDo]: Calculating:" expression; let calcResponse=model("SesiDo-Flash"){thinkingLevel: minimalThink, temperature: minimalTemp, stream: streamOutput}{"Calculate the following expression and provide the result:" expression}; print calcResponse; return calcResponse}
export fn createSVG(args){let query=null; if type(args)=="object"{if args["query"]!=null{query=args["query"]}else if args["description"]!=null{query=args["description"]}}else{query=args}if query==null||query==""{return "Error: createSVG requires a description."}print "[SesiDo]: Creating SVG for:" query; let svg_output_path=svgDir+sanitize(query)+"-"+formattedTime+".svg"; let svgResponse=false; svgResponse=model("SesiDo-Flash"){thinkingLevel: mediumThink, temperature: lowTemp}{"You are a Sesi programming language code generator.\nWrite a Sesi script using the 'std/draw' module to draw the SVG requested. The Sesi drawing API is:\n\n allow \"std/draw\" in with Draw\nDraw.clear()\n- Draw.circle(cx, cy, r, fill, options = {}) -- options keys: stroke, stroke-width, opacity, class, id\n- Draw.rect(x, y, w, h, fill, options = {}) options keys: rx, ry, opacity, class, id\n- Draw.line(x1, y1, x2, y2, stroke, options = {})\n- Draw.text(x, y, content, size, fill, options = {}) -- options keys: font-family, font-weight, opacity, class, id\n- Draw.ellipse(cx, cy, rx, ry, fill, options = {})\n- Draw.polygon(points_string, fill, options = {})\n- Draw.path(d_string, fill, options = {})\n- Draw.gradient(type, id, stops_array, options = {}) -- type is \"linear\" or \"radial\", stops_array is e.g. [{\"offset\": \"0%\", \"color\": \"red\"}, {\"offset\": \"100%\", \"color\": \"blue\"}]\n- Draw.style(cssText_string)\n- Draw.save_svg(output_path, width, height)\n -- \nsave output.\nRules:\n1. Always allow \"std/draw\" in with Draw at the beginning.\n2. Sesi does not use let or var or function definitions inside the drawing statements. Just call Draw functions.\n3. Make sure to call Draw.save_svg() at the end.\n4. Output ONLY the Sesi script code inside a ```sesi code block.\nUse this function to escape text for SVG before writing it to the SVG file: ```\nfn escapeSvgText(text){let s=str(text); s=swap(s, \"&\", \"&amp;\"); s=swap(s, \"<\", \"&lt;\"); s=swap(s, \">\", \"&gt;\"); s=swap(s, \"\"\", \"&quot;\"); s=swap(s, \"'\", \"&apos;\"); return s}\n```\nDo not write any explanations before or after.\nOutput path to use: " svg_output_path "\nRequest to draw: " query}; svgResponse=split(svgResponse, "```sesi")[1]; svgResponse=split(svgResponse, "```")[0]; let filename=codeDir+sanitize(query)+"-"+formattedTime+"-svg.sesi"; let wrote=Safe.writeFile(filename, svgResponse); let savedScript=Safe.readFile(filename); if !wrote||savedScript==null||savedScript==""{return "Error: SVG script was not saved and verified at "+filename}try{sesi(filename, true)}catch(e){return "Execution error rendering SVG: "+str(e)}let savedSvg=Safe.readFile(svg_output_path); if savedSvg==null||savedSvg==""{return "Error: SVG execution finished but output verification failed at "+svg_output_path}return "Success: SVG rendered. artifact_verified=true; output="+svg_output_path+"; script="+filename}
export fn drawPixelArt(args){let query=null;if type(args)=="object"{if args["query"]!=null{query=args["query"]}else if args["description"]!=null{query=args["description"]}}else{query=args}if query==null||query==""{return "Error: drawPixelArt requires a description."}print "[SesiDo]: Creating pixel art for:" query; let png_output_path=imageDir+sanitize(query)+"-"+formattedTime+"-pixel-art.png"; let raw=model("SesiDo-Flash"){system: brain}{"Create a pixel-art specification as JSON only. Schema: {\"palette\":{\"token\":\"#RRGGBB or transparent\"},\"grid\":[[\"token\"]],\"scale\":integer,\"width\":integer,\"height\":integer,\"variations\":[{\"name\":\"short-name\",\"palette\":{\"used-token\":\"different color\"}}]}. Every grid row must have equal width. Every grid token must be a palette key. Use short string tokens. Include an empty variations array unless the request asks for variants; then each variation must change at least one palette token actually used in the grid. Request: " query}; raw=swap(raw, "```json", ""); raw=swap(raw, "```", ""); let spec=null; try{spec=from_json(trim(raw))}catch(e){return "Error: Pixel specification was not valid JSON: "+str(e)}let validation=PixelGrid.validate(spec, PixelGrid.requestsVariations(query)); if !validation["valid"]{return "Error: Pixel-grid validation failed: "+join(validation["errors"], "; ")}if len(validation["warnings"])>0{print "[SesiDo]: Pixel-grid warnings:" join(validation["warnings"], "; ")}let filename=codeDir+sanitize(query)+"-"+formattedTime+"-pixel-art.sesi"; let pixelArtResponse=PixelGrid.buildScript(spec, png_output_path); let wrote=Safe.writeFile(filename, pixelArtResponse); let savedScript=Safe.readFile(filename); if !wrote||savedScript==null||savedScript==""{return "Error: Pixel-art script was not saved and verified at "+filename}try{sesi(filename, true)}catch(e){return "Execution error rendering pixel art: "+str(e)}let savedPng=Safe.readFile(png_output_path); if savedPng==null||savedPng==""{return "Error: Pixel-art execution finished but output verification failed at "+png_output_path}let variations=spec["variations"]; let variation_outputs=[]; if variations!=null{let variation_index=0; for variation in variations{variation_index=variation_index+1; let variation_path=swap(png_output_path, ".png", "-"+PixelGrid.variationName(variation, variation_index)+".png"); let variation_script_path=swap(filename, ".sesi", "-"+PixelGrid.variationName(variation, variation_index)+".sesi"); let variation_script=PixelGrid.buildScript(spec, variation_path, variation["palette"]); let variation_wrote=Safe.writeFile(variation_script_path, variation_script); let savedVariationScript=Safe.readFile(variation_script_path); if !variation_wrote||savedVariationScript==null||savedVariationScript==""{return "Error: Variation script was not saved and verified at "+variation_script_path}try{sesi(variation_script_path, true)}catch(e){return "Execution error rendering pixel-art variation: "+str(e)}let savedVariation=Safe.readFile(variation_path); if savedVariation==null||savedVariation==""{return "Error: Variation output verification failed at "+variation_path}push(variation_outputs, variation_path)}}return "Success: Pixel art rendered. artifact_verified=true; output="+png_output_path+"; script="+filename+"; variations="+join(variation_outputs, ", ")+"; warnings="+join(validation["warnings"], "; ")}
export fn drawImage(args) {let query = null; if type(args) == "object" {if args["query"] != null { query = args["query"] } else if args["description"] != null { query = args["description"] }} else {query = args}if query == null || query == "" {return "Error: drawImage requires a description."}let cmd = ""; let refs = []; let pngResponse = false; let example = Safe.readFile("../pixel_placeholder_icon_detailed.sesi"); let docs = Safe.readFile("./../docs/getting-started/VARIABLES.md"); docs = docs +"\n"+ Safe.readFile("./../docs/getting-started/FUNCTIONS.md"); push(refs, example); push(refs, docs); refs = to_json(refs); try {print "[SesiDo]: Drawing image for:" query; prompt sys {"Create a PNG image with a Sesi script based on the following references: "refs}; prompt filename {codeDir + sanitize(query) + "-" + formattedTime + "-image"}; if hasGPT {pngResponse = model("SesiDo-GPT") {thinking: "medium", system: sys, cache: true} {"User Prompt: "query"\nFilename to save as: "filename"\nUse the output directory "imageDir}} else {pngResponse = model("SesiDo-Flash") {thinking: "medium", system: sys, cache: true} {"User Prompt: "query"\nFilename to save as: "filename"\nUse the output directory "imageDir}} if pngResponse != "" {if contains(pngResponse, "/*") {pngResponse = "/*" + split(pngResponse, "/*")[1]}pngResponse = swap(pngResponse, "```sesi", ""); pngResponse = trim(split(pngResponse, "```", "")[0]); filename = filename + ".sesi"; Safe.writeFile(filename, pngResponse); }try {cmd = sesi(filename); filename = swap(filename, codeDir, imageDir); filename = swap(filename, ".sesi", ".png"); let successMsg = "Success: Drawn image for " + query + " and saved to " + imageDir + "\nartifact_verified=true"; print "[SesiDo]:" successMsg; return pngResponse + "\n\n" + successMsg} catch (e) {print "[SesiDo]: ⚠ Error rendering image:" str(e); return "Error rendering image: " + str(e)}} catch (e) {print "[SesiDo]: ⚠ Error generating image:" str(e); return "Error generating image: " + str(e)}}
export fn generateImage(args){let query=null; if type(args)=="object"{if args["query"]!=null{query=args["query"]}else if args["prompt"]!=null{query=args["prompt"]}}else{query=args}if query==null||query==""{return "Error: generateImage requires a prompt."}print "[SesiDo]: Generating image for:" query; let preImage=model("SesiDo-Lite"){thinkingLevel: lowThink, temperature: mediumTemp, max_tokens: 300, system: brain}{"Enhance this image request with verbosity and details:" query}; let imageResponse=""; if hasGPT {imageResponse = image("SesiDo-GPT-Image") {square, mediumTemp} {"Generate image for the following request: " preImage}} else {imageResponse = image("SesiDo-Image"){ratio: square, temperature: mediumTemp}{"Generate image for the following request:" preImage}} let filename=imageDir+sanitize(query)+"-"+formattedTime+"-image.png"; let wrote=Safe.writeImage(filename, imageResponse); let savedImage=Safe.readFile(filename); if !wrote||savedImage==null||savedImage==""{return "Error: Generated image was not saved and verified at "+filename}return "Success: Image generated. artifact_verified=true; output="+filename}
export fn getImageInfo(args){let imagePath=null; if type(args)=="object"{if args["path"]!=null{imagePath=args["path"]}else if args["imagePath"]!=null{imagePath=args["imagePath"]}else if args["image"]!=null{imagePath=args["image"]}}else{imagePath=args}if imagePath==null||imagePath==""{return "Error: getImageInfo requires an image path."}if !contains(imagePath, "/"){imagePath=imageDir+imagePath}print "[SesiDo]: Analyzing image at:" imagePath; let info=model("SesiDo-Flash"){images:imagePath, thinkingLevel: lowThink, temperature: lowTemp}{"Provide metadata, details, and a rich description about the image and observable content."}; let filename=imageDir+sanitize(imagePath)+"-image-info.md"; Safe.writeFile(filename, info); print "[SesiDo]: Image info for" imagePath ":" info; return info}
export fn browsePage(args){let url=null; let operation="fetch"; if type(args)=="array"{if len(args)>0{url=args[0]}if len(args)>1{operation=args[1]}}else if type(args)=="object"{if args["url"]!=null{url=args["url"]}else if args["page"]!=null{url=args["page"]}if args["operation"]!=null{operation=args["operation"]}else if args["action"]!=null{operation=args["action"]}}else{url=args}if url==null||url==""{return "Error: browsePage requires a URL."}if contains(url, ".html") || contains(url, ".htm") {if !contains(url, "://") {if slice(url, 0, 1) == "/" {url = "file://" + url} else {url = "file://" + Safe.wsRoot + "/" + url}}} else if !contains(url, "://") {url="https://"+url}print "[SesiDo]: Browser operation '" operation "' on:" url; let browserResponse=""; try{let browser=launch({"headless":true}); let page=browser.newPage(); page.goto(url); let pageContent=page.inner_text("body"); let pageTitle=page.title(); if pageContent==null{pageContent=""}if pageTitle==null{pageTitle=""}if len(pageContent)>12000{pageContent=slice(pageContent, 0, 12000)}if operation=="fetch"||operation=="get"||operation=="fetch_page"{if pageContent!=""{browserResponse=summarize({"text":pageContent})}else{browserResponse="Page loaded but no text content found in body. Title: "+pageTitle}}else if operation=="scrape"||operation=="extract"{browserResponse=pageContent}else if operation=="research"||operation=="search"{if pageContent==""{browserResponse="No page content to research. Title: "+pageTitle}else if len(pageContent)<500{return "Not enough page content for meaningful research. Use analyze or scrape instead."}else{browserResponse=research({"query":pageContent})}}else if operation=="analyze"||operation=="analyze_page"{if pageContent!=""{browserResponse=model("SesiDo-Lite"){temperature: lowTemp}{"Page Title:" pageTitle " Content:" pageContent " Analyze this web page's structure, purpose, and key elements."}}else{browserResponse="Page loaded but no content to analyze. Title: "+pageTitle}}else if operation=="screenshot"||operation=="capture"{page.screenshot({"path":browserDir+sanitize(url)+"-"+formattedTime+"-screenshot.png", "fullPage":true}); browserResponse="Screenshot captured and saved for "+url}else{browserResponse="Operation not recognized. Available: fetch, scrape, research, analyze, screenshot"}page.close(); browser.close()}catch(e){print "[SesiDo]: ⚠ Browser operation failed(" str(e)")"; browserResponse="Browser operation failed: "+str(e)}let filename=browserDir+sanitize(url)+"-"+formattedTime+"-browser.md"; Safe.writeFile(filename, browserResponse); print "[SesiDo]: Browser results saved to" browserDir "!"; return browserResponse}
// Session Management
export fn createSession(args){let sid=null; if type(args)=="object"{sid=args["id"]; if sid==null{sid=args["sessionId"]}if sid==null{sid=args["name"]}}else{sid=args}if sid==null||sid==""||sid=="{}"{sid="session-"+universalTime; sid=swap(sid, " ", "-")}if contains(sid, "/")||contains(sid, "\\")||contains(sid, ".."){return "Error: Session ID cannot contain '/', '\\', or '..'."}let existing=sessions.find({"id":sid}); if len(existing)>0{return "Error: Session '"+sid+"' already exists. Use open/switchSession to load it."}sessions.insert({"id":sid, "created":universalTime}); currentSessionId=sid; let sessionDir=logsDir+sid+"/"; make_dir(sessionDir); sessionLogPath=sessionDir+"agent-"+formattedTime+".log"; brain=get_base_brain(); let msg="Success: Created and switched to new session '"+sid+"'."; print "[SesiDo]:" msg; return msg}
export fn clearCurrentSession(){print "[SesiDo]: Clearing history for session:" currentSessionId; try{history.delete({"sessionId":currentSessionId}); brain=get_base_brain(); print "[SesiDo]: Cleared history and reset memory for session:" currentSessionId; return "Success: History cleared and memory reset for session '"+currentSessionId+"'."}catch(e){print "[SesiDo]: Error clearing session history:" str(e); return "Error clearing session:"+str(e)}}
export fn switchSession(args){let sid=null; if type(args)=="object"{sid=args["id"]; if sid==null{sid=args["sessionId"]}if sid==null{sid=args["name"]}}else{sid=args}if sid==null||sid==""||sid=="{}"{return "Error: switchSession requires a session id(e.g.{id:'my-session'})."}print "[SesiDo]: Switching to session:" sid; loadSession(sid); return "Success: Switched to session '"+sid+"'. You are now in a fresh or existing context for this ID."}
fn logTimestamp(name){let parts=split(name, "-"); if len(parts)!=8||parts[0]!="agent"{return -1}let hour=num(parts[4]); let suffix=to_lower(parts[7]); if contains(suffix, "pm")&&hour<12{hour=hour+12}else if contains(suffix, "am")&&hour==12{hour=0}return num(parts[3])*10000000000+num(parts[1])*100000000+num(parts[2])*1000000+hour*10000+num(parts[5])*100+num(parts[6])}
export fn listSessions(){let res="Conversation logs directory: "+logsDir; let sessionDir=logsDir+currentSessionId+"/"; let previousLog=""; try{let entries=list_dir(logsDir); if len(entries)==0{res=res+"\nNo log sessions found."}else{res=res+"\nLog sessions:"; for entry in entries{res=res+"\n- "+entry}}let currentLogKey=logTimestamp("agent-"+formattedTime+".log"); let previousLogKey=-1; let sessionEntries=list_dir(sessionDir); for entry in sessionEntries{let entryKey=logTimestamp(entry); if entryKey<currentLogKey&&entryKey>previousLogKey{previousLog=entry; previousLogKey=entryKey}}if previousLog!=""{res=res+"\nPrevious conversation log: "+sessionDir+previousLog}}catch(e){res=res+"\nError listing log sessions: "+str(e)}let sList=sessions.find(); if len(sList)==0{return res}res=res+"\nAvailable sessions:"; for s in sList{let activeMark=""; if s["id"]==currentSessionId{activeMark="(active)"}res=res+"\n- "+s["id"]+activeMark}print "[SesiDo]" res; return res}
// Utility
export fn textSearch(args){let path="."; let query=""; if type(args)=="object"{if args["path"]!=null{path=args["path"]}if args["query"]!=null{query=args["query"]}}else{query=str(args)}if query==""||query=="{}"{return "Error: textSearch requires a query."}let cmd="sesi --cli -l helpers/text-search.sesi folder "+quote(path)+" "+quote(query)+" --skip node_modules --skip .git --skip sesi_modules"; try{let result=exec(cmd); return result}catch(e){return "textSearch error:"+str(e)}}
export fn fileOps(args){let cmd_arg=""; let path=""; let extra=""; if type(args)=="object"{if args["command"]!=null{cmd_arg=args["command"]}else if args["cmd"]!=null{cmd_arg=args["cmd"]}else if args["cmd_arg"]!=null{cmd_arg=args["cmd_arg"]}if args["path"]!=null{path=args["path"]}else if args["target"]!=null{path=args["target"]}if args["text"]!=null{extra=args["text"]}else if args["extra"]!=null{extra=args["extra"]}if args["old"]!=null{extra=args["old"]; if args["new"]!=null{extra=extra+" "+args["new"]}}}else{cmd_arg=str(args)}if cmd_arg==""||cmd_arg=="{}"{return "Error: fileOps requires a command (write, append, copy, replace, etc)."}let userInput = input("SesiDo Agent is trying to run fileOps: \nPath"+path+"\nCommand: "+cmd_arg+"\nOther Args: "+extra+"\nProceed? (y/n) "); if to_lower(trim(userInput))!="y"{return "Error: User rejected fileOps request."}if to_lower(trim(userInput))=="y"{ if path==null||path==""{if extra!=""&&(cmd_arg=="write"||cmd_arg=="append"){let parts=split(extra, " "); path=parts[0]; extra=join(slice(parts, 1, len(parts)), " ")}}let cli="sesi --cli -l helpers/agent-file-ops.sesi "+cmd_arg+" "+quote(path); if extra!=""{cli=cli+" "+quote(extra)}try{let result=exec(cli); return result}catch(e){return "fileOps error:"+str(e)}}}
export fn commitMessage(args){let mode="--staged"; let write_path=null; if type(args)=="object"{if args["mode"]!=null{mode="--"+args["mode"]}if args["write"]!=null{write_path=args["write"]}}else{if args!=null&&args!=""{mode="--"+str(args)}}let cli="sesi --cli -l helpers/commit-message.sesi "+mode; if write_path!=null{cli=cli+" --write "+quote(write_path)}try{let result=exec(cli); return result}catch(e){return "commitMessage error:"+str(e)}}
export fn lineSwap(args){let path=null; let from_text=null; let to_text=null; let options=null; if type(args)=="object"{path=args["path"]; from_text=args["from"]; to_text=args["to"]; options=args["options"]}if path==null||from_text==null||to_text==null{return "Error: lineSwap requires path, from, and to."}let cli="sesi --cli -l helpers/line-swap.sesi "+quote(path)+" "+quote(from_text)+" "+quote(to_text); if options!=null{cli=cli+" "+quote(options)}try{let result=exec(cli); return result}catch(e){return "lineSwap error:"+str(e)}}
export fn makeSVGBadge(args){let path=null; let label=null; let value=null; let color=null; if type(args)=="object"{path=args["path"]; label=args["label"]; value=args["value"]; color=args["color"]}if path==null||label==null||value==null||color==null{return "Error: makeSVGBadge requires path, label, value, and color."}let cli="sesi --cli -l helpers/svg-badge.sesi "+" "+quote(label)+" "+quote(value)+" "+quote(color)+" "+quote(path); try{let result=exec(cli); return result}catch(e){return "makeSVGBadge error:"+str(e)}}
export fn makeSVGBanner(args){let path=null; let title=null; let tagline=null; let theme=null; let inject=null; if type(args)=="object"{path=args["path"]; title=args["title"]; tagline=args["tagline"]; theme=args["theme"]; inject=args["inject"]}if path==null||title==null{return "Error: makeSVGBanner requires path and title."}let cli="sesi --cli -l helpers/readme-banner.sesi "+quote(title)+" "+quote(path); if tagline!=null{cli=cli+" --tagline "+quote(tagline)}if theme!=null{cli=cli+" --theme "+quote(theme)}if inject!=null{cli=cli+" --inject "+quote(inject)}try{let result=exec(cli); return result}catch(e){return "makeSVGBanner error: "+str(e)}}
// Tool Registry
export fn localTools(){let tool_refs={}fn register_tool(name:string, func, desc:string){define_tool(name, func, desc); tool_refs[name]=desc}register_tool("makeDir", newDir, "Creates a directory at the specified path. Args: {path:}"); register_tool("read", read, "Safely reads a file. Args: {path: string}"); register_tool("write", write, "Safely writes a file. Args: {path: string, content: string}"); register_tool("appendTo", appendTo, "Appends to a file. Args: {path: string, content: string}"); register_tool("remove", remove, "Safely removes a file. Args: {path: string}"); register_tool("move", move, "Moves a file or directory. Args: {path: string, dest: string}"); register_tool("list", list, "Safely lists a directory. Args: {path: string}"); register_tool("runSesi", runSesi, "Executes one Sesi script by path. Args: {path: string}"); register_tool("safeRun", safeRun, "Safely runs a terminal command. USE WITH CAUTION. Args: {command: string}"); register_tool("eval", eval, "Safely eval Sesi code. Args: {code: string}"); register_tool("httpGet", httpGet, "HTTP GET. Args: {url: string, headers?: object}"); register_tool("httpSend", httpSend, "HTTP POST/SEND. Args: {url: string, data: any, headers?: object}"); register_tool("writeCode", writeCode, "Generates code. Args: {query: string}"); register_tool("debugCode", debugCode, "Debugs code. Args: {path: string}"); register_tool("research", research, "Researches a topic. Args: {query: string}"); register_tool("summarize", summarize, "Summarizes text/file. Args: {text: string} Note: accepts both text and explicit path."); register_tool("calculator", calculator, "Calculates math. Args: {expression: string}"); register_tool("createSVG", createSVG, "Generates SVG. Args: {description: string}"); register_tool("generateImage", generateImage, "Generates image. Args: {query: string}"); register_tool("drawPixelArt", drawPixelArt, "Generates pixel art / avatars / pixel-art visuals. Args: {description: string}"); register_tool("drawImage", drawImage, "Draws an image without calling an image generator. Args: {description: string}"); register_tool("getImageInfo", getImageInfo, "Analyzes image. Args: {path: string}"); register_tool("browsePage", browsePage, "Browse and access web pages. Args: {url: string, operation?: string}. Operations: fetch (summarize page), scrape (extract raw text), research (query content), analyze (structure analysis), screenshot (full page capture)"); register_tool("createSession", createSession, "Creates a new chat session with the specified ID or name. Args: {id: string}"); register_tool("clearCurrentSession", clearCurrentSession, "Wipes the history and memory of the ACTIVE session only. Use this to 'reset' without changing the session name."); register_tool("switchSession", switchSession, "Switch to a different session or CREATE a new one by providing a unique name/ID. Args: {id: string}"); register_tool("listSessions", listSessions, "Lists all available chat sessions so you can see what IDs exist."); register_tool("textSearch", textSearch, "Searches for a query string across files. Args: {path: string, query: string}. Path defaults to '.' (entire project)."); register_tool("fileOps", fileOps, "Performs file mutations: write, append, copy, replace, insert-before, insert-after, replace-block. Args: {command: string, path: string, text?: string, old?: string, new?: string}."); register_tool("commitMessage", commitMessage, "Generates a git commit message from staged or unstaged diffs. Args: {mode: 'staged'|'unstaged'|'all', write?: string}."); register_tool("lineSwap", lineSwap, "Swaps two lines in a file. Args: {path: string, from_text: string, to_text: string, options?: string}."); register_tool("makeSVGBadge", makeSVGBadge, "Creates an SVG badge. Args:{path: string, label: string, value: string, color: string}."); register_tool("makeSVGBanner", makeSVGBanner, "Creates an SVG banner. Args: {path: string, title: string, tagline?: string, theme?: string}."); let _registry=list_tools(); print "local tool registry loaded -" str(len(_registry))"tools available"; print to_json(tool_refs)}
export fn list_tool_names(tool_map){if tool_map==null{return ""}let desc=""; for name in keys(tool_map){desc=desc+"-"+name+"; "}return desc}
// Help Menu
fn showhelp(){print "[SesiDo]: How can I assist you today?
            -Enter 'new' to create a new agent session.
            -Enter 'list' to see all available sessions.
            -Enter 'open' to open a specific session by ID.
            -Enter 'clear' to clear the current chat session.
            -Enter 'help' to see this message again.
            -Enter 'voice' to enable agent voice mode (if supported).
            -Enter 'exit' or 'quit' to end the session."}
// Main Chat Loop
fn chat(){let tool_map={}; tool_map["newDir"] = newDir; tool_map["read"]=read; tool_map["write"]=write; tool_map["appendTo"]=appendTo; tool_map["remove"]=remove; tool_map["move"] = move; tool_map["list"]=list; tool_map["runSesi"]=runSesi; tool_map["safeRun"]=safeRun; tool_map["eval"]=eval; tool_map["httpGet"]=httpGet; tool_map["httpSend"]=httpSend; tool_map["writeCode"]=writeCode; tool_map["debugCode"]=debugCode; tool_map["research"]=research; tool_map["summarize"]=summarize; tool_map["calculator"]=calculator; tool_map["createSVG"]=createSVG; tool_map["generateImage"]=generateImage; tool_map["drawPixelArt"] = drawPixelArt; tool_map["drawImage"] = drawImage; tool_map["getImageInfo"]=getImageInfo; tool_map["browsePage"]=browsePage; tool_map["createSession"]=createSession; tool_map["switchSession"]=switchSession; tool_map["listSessions"]=listSessions; tool_map["textSearch"]=textSearch; tool_map["fileOps"]=fileOps; tool_map["commitMessage"]=commitMessage; tool_map["lineSwap"]=lineSwap; tool_map["makeSVGBadge"]=makeSVGBadge; tool_map["makeSVGBanner"]=makeSVGBanner; let tools_desc=list_tool_names(tool_map); let last_tool_name=""; let last_tool_args={}; showhelp(); while true{let userInput=input("[You]: "); let cmd=trim(userInput); userInput=cmd; if userInput=="exit"||userInput=="quit"||userInput==""{print "[SesiDo]: Goodbye!"; break}if userInput=="clear"{clearCurrentSession(); continue}if userInput=="new"{print "[SesiDo]: Enter a new session ID (or leave blank to auto-generate):"; let newSessionId=input("[You]: "); let result=createSession(newSessionId); print result; continue} if userInput=="list"{listSessions(); continue} if userInput=="open"{print "[SesiDo]: Enter the session ID you want to open:"; let sessionId=input("[You]: "); let result=switchSession(sessionId); print result; continue} if userInput=="help"{showhelp(); continue} if userInput=="voice"{agentVoice.toggle(); continue} if userInput=="try again"{if last_tool_name==""{print "[SesiDo]: No previous tool call to retry."; continue}let retry_tool=tool_map[last_tool_name]; let retry_result=retry_tool(last_tool_args); print retry_result; continue}let direct_tool=tool_map[userInput]; if direct_tool!=null{last_tool_name=userInput; last_tool_args={}; let direct_result=direct_tool(last_tool_args); print direct_result; continue} print "[SesiDo]: Thinking..."; let steps_taken=0; let react_history=""; let final_res=""; let error_count=0; resetEvidence(userInput)
let max_steps=num(trim(input("Max amount of steps for SesiDo agent to take each turn in this session? 'Enter a numerical value or leave blank for default (20)': "))); if max_steps==null||max_steps<1{max_steps=20} while steps_taken<max_steps{print "[SesiDo]: Step "+str(steps_taken+1)+"/"+str(max_steps); prompt react_prompt{"System: You are an agent with access to these tools:
" tools_desc "
Solve the user's request in as few steps as possible, using tools only when helpful or requested. Do not inspect directories, files, tools, or project context before a self-contained request that directly maps to one registered tool. Exception: for questions about local files, workspace layout, conversation history, session state, log locations, or tool access, inspect the relevant local path before answering. Never state that a local file, log, session record, directory, or capability is unavailable, inaccessible, internal-only, or located at a path unless a tool result from this turn proves that claim. The workspace root and the agent's data directory are configured independently; use the configured path or an inspection result, never an inferred or hard-coded root. When a user corrects a factual claim, stop repeating it, inspect the corrected path immediately, and answer from the result. For a request to create pixel art, an avatar, a pixel-art visual, SVG, or image, call the corresponding generation tool in the first step using the user's request as its argument. For createSVG and drawPixelArt, tool_args_json MUST be a JSON object with a non-empty description string, for example: {\"description\":\"prompt\"}. For generateImage, tool_args_json MUST be a JSON object with a non-empty query string, for example: {\"query\":\"prompt\"}. At each step, output a JSON object with ONLY these keys:
    - thought(string): your reasoning(be descriptive but avoid verbatim recitation of known long texts)
    - tool_name(string): name of tool to call, or empty string if done
    - tool_args_json(string): A VALID JSON string of arguments for the tool (keys MUST be quoted). NEVER leave this empty if you are calling a tool, you MUST provide the args required.
    - finished(bool): true if you have a final answer
    - final_answer(string): your final response if finished is true, else empty string 
\nIf asked by the user to provide identity statements, respond conversationally in plain text, covering what you are(and are not), your boundaries, and your value to the user. 
General shell commands are disabled by default.
\nAllowed:
- runSesi is reserved only for executing a specific Sesi script or approved helper.
- No raw mkdir/ls/find/grep/rm/cp/mv/etc. unless explicitly authorized for this turn.
- DO NOT USE EVAL TO BYPASS SHELL ACCESS LIKE EXEC FOR GIT, PWD, OR ANYTHING SECURITY RELATED! Always confirm with the user FIRST!
- safeRun is only allowed if terminal access is available and explicitly authorized for this turn.
\nWhen the user names or refers to a tool by its registered name(i.e., \"research tool\" or \"calculator tool\") use that registered tool first.
Bind explicit paths directly to requested tools without discovery first. Use runSesi for a direct .sesi path. Reproduce reported generated-code failures before patching. Stop repeated no-information discovery after two attempts. Only use safeRun as fallback if the tool fails, is unavailable, or the user explicitly asks for direct helper execution.
\nPreferred:
- newDir for creating directories
- move for moving files or directories
- list for directory inspection
- read for file inspection
- appendTo for appending to files
- remove for deleting files or directories
- write for writing exact file contents, including Sesi scripts
- writeCode for generating code suggestions or non-Sesi code artifacts (e.g. Python, Typescript, etc.)
- debugCode for debugging code (e.g. Python, Typescript, etc.)
- textSearch for searching
- fileOps for other file operations
- lineSwap for line replacement
- browsePage for browsing web pages
- httpGet for simple HTTP GET requests
- httpSend for simple HTTP POST requests
- createSVG for creating SVGs (this excludes the badge and banner generators)
- generateImage for generating images
- drawImage for drawing images without calling an image generator
- drawPixelArt for generating pixel art
- commitMessage for generating commit messages
- eval for small Sesi snippets or making directories
\n\n### Agent Protocols:
ALL GENERATED ARTIFACTS MUST BE SAVED UNDER "artifactsDir" or a subdirectory of it. Do not write to the workspace root or any other directory unless explicitly requested by the user.
\n- Denied Destructive Operation Protocol
If a deletion, overwrite, truncation, relocation, permission change, or execution request is rejected by the user or safeguard layer:
\n1. Treat the rejection as applying to the user’s destructive intent, not merely to the specific tool call.
2. Do not attempt equivalent destructive actions through alternate tools, scripts, shell commands, fileOps, eval, safeRun, or generated helper scripts.
3. Do not retry the same destructive action unless the user explicitly reauthorizes it in a new instruction.
4. Preserve the current workspace state.
5. Explain what was blocked and why no bypass was attempted.
6. Offer safe alternatives only:
   - generate a patch/diff for user review
   - list files that would have been affected
   - create a backup plan
   - mark the item for manual deletion
   - update handoff notes with the blocked action
\nIf the user canceled a tool execution in the previous turn, move on to the next step. DO NOT try again without explicit permission.
\nIf a tool returns an expected guardrail message during a safeguard/edge-case test, treat that as a pass. Do not immediately inspect the file unless the user asks.
\nIf tool output is empty or returns an error:
    retry up to 2 times MAX, no more than that for idempotent operations. 
    then verify using an independent check. 
If generating standard documents like licenses or policies, draft a custom version to avoid recitation blocks. 
For branding updates:
    Preserve existing tagline, theme, dimensions, and file path unless the user specifies a change. Only change the requested brand string. 
\n## Final Answer Guidelines:
    - Be direct, professional, and clear.
    - Use PLAIN TEXT for your response. Do not use Markdown headers(like # or ###), bolding(**), or lists unless specifically requested by the user.
    - Preserve your \"Architect of Intel\" persona: sharp, sophisticated, and nuanced, but conversational.
    - If you made changes or generated files, list them clearly in a simple text format. 
\nThe completion ledger below is authoritative. For every required stage whose value is true, the matching completion-ledger value must also be true before you may set finished=true. If any required stage is incomplete, call the tool needed to obtain that evidence; do not merely describe the missing work.\nCompletion ledger: " to_json(activeLedger) "\nRequired stages: " to_json(activeRequirements) "\nUser: " userInput "\nStep budget: You are currently on step " str(steps_taken + 1) " of " str(max_steps) ". Plan accordingly and finish before the limit.\nPrevious steps: " react_history "\nNext Step JSON:"}; let step_text=""; try{step_text=model("SesiDo-Pro"){thinkingLevel: mediumThink, system: brain}{react_prompt}}catch(e){if hasGPT {print "[SesiDo]: ⚠ SesiDo failed("str(e)"). Retrying with SesiDo-GPT-Lite..."; try{step_text=model("SesiDo-GPT-Lite"){thinkingLevel: mediumThink, system: brain}{react_prompt}}catch(e){}}{print "[SesiDo]: ⚠ SesiDo failed("str(e)"). Retrying with SesiDo-Lite-Power..."; try{step_text=model("SesiDo-Lite-Power"){thinkingLevel: mediumThink, temperature: lowTemp, system: brain}{react_prompt}}catch(e2){print "[SesiDo]: SesiDo-Lite-Power failed("str(e2)"). Retrying with SesiDo-Flash..."; try{step_text=model("SesiDo-Flash"){system: brain}{react_prompt}}catch(e3){print "[SesiDo]: ❌ All retry models failed."}} final_res="I encountered a safety or technical block across all models. Please rephrase your request."; break}} if contains(step_text, "{")&&contains(step_text, "}"){let s_idx=-1; let e_idx=-1; let i=0; let total_len=len(step_text); while i<total_len{let char=slice(step_text, i, i+1); if char=="{"&&s_idx==-1{s_idx=i} if char=="}"{e_idx=i+1} i=i+1} if s_idx!=-1&&e_idx!=-1{step_text=slice(step_text, s_idx, e_idx)}}let step=structured_output({thought:string, tool_name:string, tool_args_json:string, finished:bool, final_answer:string})(step_text); if step==null||len(keys(step))==0{print "[SesiDo]: ⚠ Could not parse reasoning step."; error_count=error_count+1; react_history=react_history+" Thought: Failed to parse step response. Observation: Invalid JSON format. "; if error_count>=3{final_res="I ran into repeated errors trying to reason through that. Please try again."; break}}else{print "💭" step["thought"]; if step["finished"]{let proposedAnswer=step["final_answer"]; let guardedAnswer=guardEvidence(proposedAnswer); if guardedAnswer==proposedAnswer{final_res=proposedAnswer; break}react_history=react_history+"\nObservation: Completion blocked. "+guardedAnswer+"\n"; steps_taken=steps_taken+1; continue} let tool_name=step["tool_name"]; let tool_args_str=step["tool_args_json"]; let tool_args=null; if tool_args_str!=null&&tool_args_str!=""{tool_args=from_json(tool_args_str); if tool_args==null{tool_args=tool_args_str}} if tool_args==null{tool_args={}} let obs=""; if tool_name==null||tool_name==""{obs="Reasoning step completed. No tool called."}else{print "🛠️ Calling tool:" tool_name; let tool_fn=tool_map[tool_name]; let preflight=evidencePreflight(userInput, tool_name, tool_args); if preflight!=""{obs=preflight}else if tool_fn==null{obs="Error: Tool '"+tool_name+"' is not registered."; print "[SesiDo]: ❌ Tool not found:" tool_name; error_count=error_count+1}else{try{obs=tool_fn(tool_args); print "📥 Observation:" obs; error_count=0}catch(e){obs="Error executing tool:"+str(e); print "[SesiDo]: ❌ Tool error:" e; error_count=error_count+1}}recordEvidence(tool_name, tool_args, obs)}if error_count>=3{final_res="I encountered too many errors using tools. Please try again."; break}react_history=react_history+"\nThought: "+step["thought"]+"\nTool: "+tool_name+"\nObservation: "+obs+"\n"}steps_taken=steps_taken+1}if final_res==""{final_res="⚠️ Reached max reasoning steps without a final answer. Last steps: "+react_history}final_res=guardEvidence(final_res); print "[SesiDo]:" final_res; agentVoice.response(final_res); let logEntry="["+time()+"ms][USER]: "+userInput+"\n[THOUGHTS]:"+react_history+"\n[ASSISTANT]: "+final_res+"\n-----------------------------------\n"; try{Safe.appendFile(sessionLogPath, logEntry)}catch(e){}history.insert({"sessionId":currentSessionId, "role":"User", "content":userInput, "timestamp":universalTime}); history.insert({"sessionId":currentSessionId, "role":"Assistant", "content":final_res, "timestamp":universalTime}); brain=brain+"User:"+userInput+" Assistant:"+final_res+"; "}}
export fn main(){print "[SesiDo]: Starting chat..."; let logTag = "[" + universalTime + "]"; print logTag + " [CHAT]"; chat(); print "[CHAT ENDED]"}