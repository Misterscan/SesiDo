/**
  Save a temporary file with try/catch.

  Parameters:
  - filename: The name of the file (without extension).
  - content: The content to write to the file.
  - ext: The file extension.

  Returns:
    The result of the write operation.
*/
export fn tempFile(filename: string, content: string, ext: string) {
  return write(filename + "_temp." + ext, content)
}

/**
  Save a temporary binary file with try/catch.

  Parameters:
  - filename: The name of the file (without extension).
  - content: The content to write to the file.
  - ext: The file extension.

  Returns:
    The result of the write operation.
*/
export fn tempMedia(filename: string, content: string, ext: string) {
  return write(filename + "_temp." + ext, content, "base64")
}

/**
  Save a temporary folder with temp files scaffolded.

  Parameters:
  - name: The name of the temporary folder.
  - files: An array of file names to create in the folder.

  Returns:
    True if all files were successfully created, false otherwise.
*/
export fn tempFolder(name: string, files: array<string>) -> bool {
  let dir = "temp/" + name + "/"
  createFolder(dir)

  for file in files {
    try {
      write(dir + file, "")
      show "Scaffolded" file "in" dir
    } catch (e) {
      show "Failed to write" file "to" dir ":" e.message
      return false
    }
  }

  return true
}