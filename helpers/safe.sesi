/**
  Safe File Access
  Resilient file operations wrapped in try-catch blocks with retry logic to prevent crashes.

  This module provides safe and resilient file operations, including reading, writing, and checking file existence, with built-in retry logic to handle transient errors gracefully.
*/

allow "std/time" in as Time

/**
  Get the file extension from a given path.

  Parameters:
  - `path`: The file path from which to extract the extension.

  Returns:
  The file extension as a string, or an error message if the extension cannot be determined.
*/
export fn getExtension(path: str) -> str {
  try {
    let ext = get_ext(path)
    if ext == "" || is_null(ext) {
      return "No extension found"
    }
    return ext
  } catch (err) {
    return "Error getting extension: " + err | str
  }
}

/**
  Compatibility for versatility.
  These functions provide alternative names for `getExtension` to improve code readability and flexibility.
*/

/**
  Get the file extension from a given path (alternative name for `getExtension`).
*/
export fn getExt(path: str) -> str {
  return getExtension(path)
}

/**
  Get the file extension from a given path (alternative name for `getExtension`).
*/
export fn getFileExtension(path: str) -> str {
  return getExtension(path)
}

/**
  Get the file extension from a given path (alternative name for `getExtension`).
*/
export fn getFileExt(path: str) -> str {
  return getExtension(path)
}

/**
  Get the file extension from a given path (alternative name for `getExtension`).
*/
export fn getFileType(path: str) -> str {
  return getExtension(path)
}

/**
  Get the file extension from a given path (alternative name for `getExtension`).
*/
export fn extension(path: str) -> str {
  return getExtension(path)
}

/**
  Get the file extension from a given path (alternative name for `getExtension`).
*/
export fn ext(path: str) -> str {
  return getExtension(path)
}

/**
  Safe file read with retry logic.
  Attempts to read a file up to 3 times in case of transient errors.

  Parameters:
  - `path`: The path to the file to read.
  - `mode`: The mode in which to read the file (default is "text").

  Returns:
  The content of the file as a string, or an empty string if reading fails after 3 attempts.
*/
export fn readFile(path: string, mode: string = "text") -> string {
  let result = ""
  let success = false
  let attempts = 0
  while !success && attempts < 3 {
    try {
      if mode == "" || is_null(mode) {
        mode = "text"
      }
      result = read_file(path, mode)
      success = true
    } catch (err) {
      attempts = attempts + 1
      Time.sleep(100)
    }
  }
  return result
}

/**
  Read a file using the safe read logic (alternative name for `readFile`).
*/
export fn read(path: string) -> string {
  return readFile(path)
}
/**
  Get the content of a file using the safe read logic (alternative name for `readFile`).
*/
export fn getContent(path: string) -> string {
  return readFile(path)
}

/**
  Get the content of a file using the safe read logic (alternative name for `readFile`).
*/
export fn contents(path: string, mode: string = "text") -> string {
  if mode == "" || is_null(mode) {
    mode = "text"
  }
  return readFile(path, mode)
}

/**
  View the content of a file using the safe read logic (alternative name for `readFile`).
*/
export fn view(path: string, mode: string = "text") -> string {
  if mode == "" || is_null(mode) {
    mode = "text"
  }
  return readFile(path, mode)
}

/**
  View the content of a file using the safe read logic (alternative name for `readFile`).
*/
export fn viewFile(path: string) -> string {
  return readFile(path)
}

/**
  View the content of a media file using the safe read logic (alternative name for `readFile` with "base64" mode).
*/
export fn viewMedia(path: string) -> string {
  return readFile(path, "base64")
}

/**
  Get contents from a file as a string but with the filename prepended (more useful for LLMs).

  Returns:
  A string containing the filename and the content of the file.
*/
export fn fromFile(path: string) -> string {
  return "Filename: " + path + "\nContent: " + read(path)
}

/**
  Get contents of multiple files as an array of strings (with filenames prepended).

  Parameters:
  - `paths`: An array of file paths to read.

  Returns:
  An array of strings, each containing the filename and the content of the corresponding file.
*/
export fn fromFiles(paths: array) -> array<string> {
  let contents = []
  for path in paths {
    push(contents, "Filename: " + path + "\nContents: " + readFile(path))
  }
  return contents
}

/**
  Check if a file exists at the given path.

  Parameters:
  - `path`: The path to the file to check.

  Returns:
  `true` if the file exists, `false` otherwise.
*/
export fn fileExists(path: string) -> bool {
  return exists(path)
}

/**
  Check if a path exists at the given path (alternative name for `fileExists`).
*/
export fn pathExists(path: string) -> bool {
  return fileExists(path)
}

/**
  Verify if a file exists at the given path (alternative name for `fileExists`).
*/
export fn verifyFile(path: string) -> bool {
  return fileExists(path)
}

/**
  Verify if a path exists at the given path (alternative name for `pathExists`).
*/
export fn verifyPath(path: string) -> bool {
  return pathExists(path)
}

/**
  Verify if a file exists at the given path (alternative name for `fileExists`).
*/
export fn verify(path: string) -> bool {
  return fileExists(path)
}

/**
  Write a file to the given path with retry logic for resilience.

  Parameters:
  - `path`: The path to the file to write.
  - `content`: The content to write to the file.
  - `mode`: The mode to use for writing the file (default is "text").

  Returns:
  A string indicating the success or failure of the write operation.
*/
export fn writeFile(path: string, content: string, mode: string = "text") -> string {
  let success = false
  let attempts = 0
  while !success && attempts < 3 {
    try {
      if mode == "" || is_null(mode) {
        mode = "text"
      }
      if ends_with(path, ".mp4") || ends_with(path, ".mp3") || ends_with(path, ".png") || ends_with(path, ".jpg") || ends_with(path, ".gif") || ends_with(path, ".webp") || ends_with(path, ".svg") || ends_with(path, ".heic") || ends_with(path, ".heif") || ends_with(path, ".tiff") || ends_with(path, ".bmp") || ends_with(path, ".mov") || ends_with(path, ".jpeg") || ends_with(path, ".webm") || ends_with(path, ".wav") || ends_with(path, ".m4a") || ends_with(path, ".ogg") || ends_with(path, ".flac") || ends_with(path, ".opus") || ends_with(path, ".aac") {
        mode = "base64"
      } else {
        mode = mode
      }
      write_file(path, content, mode)
      success = true
    } catch (err) {
      attempts = attempts + 1
      Time.sleep(100)
    }
  }
  if success == true {
    return "File written successfully at " + path
  } else {
    return "Failed to write file to " + path
  }
}

/**
  Write a file to the given path (alternative name for `writeFile`).
*/
export fn write(path: string, content: string, mode: string = "text") -> any {
  return writeFile(path, content, mode)
}

/**
  Overwrite a file at the given path if it exists, otherwise create a new file.

  Parameters:
  - `path`: The path to the file to overwrite or create.
  - `content`: The content to write to the file.
  - `mode`: The mode to use for writing the file (default is "text").

  Returns:
  A string indicating the success or failure of the write operation.
*/
export fn overwrite(path: string, content: string, mode: string = "text") -> any {
  if fileExists(path) {
    return writeFile(path, content, mode)
  } else {
    show "No file to overwrite. Creating new file at" path "."
    return writeFile(path, content, mode)
  }
}

/**
  Make a new file at the given path (alternative name for `writeFile`).
*/
export fn makeFile(path: string, content: string = "", mode: string = "text") -> any {
  return writeFile(path, content, mode)
}

/**
  Create a new file at the given path if it does not already exist. Otherwise, it will not modify the existing file.
*/
export fn newFile(path: string, content: string = "", mode: string = "text") -> any {
  if fileExists(path) {
    show "File already exists at" path "."
    return false
  }
  return writeFile(path, content, mode)
}

/**
  Make a new file at the given path if it does not already exist (alternative name for `newFile`).
*/
export fn makeNewFile(path: string, content: string = "", mode: string = "text") -> any {
  if fileExists(path) {
    show "File already exists at" path "."
    return false
  }
  return writeFile(path, content, mode)
}

/**
  Create a new file at the given path if it does not already exist (alternative name for `newFile`).
*/
export fn createFile(path: string, content: string = "", mode: string = "text") -> any {
  if fileExists(path) {
    show "File already exists at" path "."
    return false
  }
  return writeFile(path, content, mode)
}

/**
  Create a new file at the given path if it does not already exist (alternative name for `newFile`).
*/
export fn new(path: string, content: string = "", mode: string = "text") -> any {
  if fileExists(path) {
    show "File already exists at" path "."
    return false
  }
  return writeFile(path, content, mode)
}

/**
  Create a new file at the given path, overwriting it if it already exists (optimized version of `overwrite`).
*/
export fn freshFile(path: string, content: string = "", mode: string = "text") -> any {
  if fileExists(path) {
    try {
      trash(path)
    } catch (err) {
      return "Failed to delete existing file at " + path + "."
    }
  }
  return writeFile(path, content, mode)
}

/**
  Create a new file at the given path, overwriting it if it already exists (alternative name for `freshFile`).
*/
export fn fresh(path: string, content: string = "", mode: string = "text") -> any {
  return freshFile(path, content, mode)
}

/**
  Write an image to the given path with retry logic to ensure resilience.

  Parameters:
  - path: The file path where the image should be saved.
  - content: The image content to be written.
  
  Returns:
    A string indicating the success or failure of the operation.
*/
export fn writeImage(path: string, content: string) -> string {
  let success = false
  let attempts = 0
  while !success && attempts < 3 {
    try {
      write_image(path, content)
      success = true
    } catch (err) {
      attempts = attempts + 1
      Time.sleep(100)
    }
  }
  if success == true {
    return "Image saved successfully at " + path
  } else {
    return "Failed to save image to " + path
  }
}

