/**
  Check if a directory exists and return true if it does, false otherwise.

  Parameters:
  - path: The directory path to check for existence.

  Returns:
    A boolean indicating whether the directory exists (`true`) or not (`false`).
*/
export fn dirExists(path: string) -> bool {
  try {
    listDir(path)
    return true
  } catch (err) {
    return false
  }
}

/**
  Check if a folder exists (alternative name for `dirExists`).
*/
export fn folderExists(path: string) -> any {
