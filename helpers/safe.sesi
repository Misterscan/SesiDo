export fn tsv(filename: string, content: any) -> any {
  return write(filename + ".tsv", content)
}

/**
  Save a file to .html with a structured html() template.

  Parameters:
  - title: The title of the HTML page.
  - content: The main content of the HTML page.
  - head: Additional content to include in the <head> section.
  - css: CSS content or a link to a CSS file (default is "").
  - language: The language of the HTML page (default is "en").
  - save: Whether to save the file or just return the HTML content (default is true).

  Returns:
    The result of the write operation or the HTML content if save is false.
*/
export fn HTML(title: string, content: string, head: string, css: any = "", language: string = "en", save: bool = true) -> any {
  if css == "" || is_null(css) {
    css = ""
  } else if css == "style.css" {
    css = "<link rel=\"stylesheet\" href=\"style.css\">"
  } else {
    "style.css" | write(css)
    css = "<link rel=\"stylesheet\" href=\"style.css\">"
  }

  if head == "" || is_null(head) {
    head = ""
  } else {
    head = head + "\n"
  }

  let config = {
    "title": title,
    "head": head + css + "\n",
    "lang": language
  }

  let webpage = html(content, config)

  if save == false {
    return webpage
  } else {
    let filename = title | to_lower | swap(" ", "_") | trim
    return write(filename + ".html", webpage)
  }
}

