/**
  Check if a directory is empty.

  Parameters:
  - path: The directory path to check.

  Returns:
    A boolean indicating whether the directory is empty (`true`) or not (`false`).
*/
export fn emptyDirCheck(path: string) -> bool {
  let attempts = 0
  while attempts < 3 {
    try {
      return len(list_dir(path)) == 0
    } catch (err) {
      attempts = attempts + 1
      Time.sleep(100)
    }
  }
  return false
}

/**
  Check if a directory is empty (alternative name for `emptyDirCheck`).
*/
export fn isEmpty(path: string) -> any {
  return emptyDirCheck(path)
}

/**
  Check if a directory is empty (alternative name for `emptyDirCheck`).
*/
export fn isEmptyDir(path: string) -> any {
  return emptyDirCheck(path)
}

/**
  Clear the contents of a directory safely.

  Parameters:
  - path: The directory path to clear.

  Returns:
    A message indicating whether the directory was successfully cleared or not.
*/
export fn clearDir(path: string) -> string {
  remove(path)
  make_dir(path)

  if path | isEmpty {
    return path + " cleared!"
  } else {
    return "Failed to clear directory: " + path
  }
}

/**
  Clear the contents of a directory safely (alternative name for `clearDir`).
*/
export fn empty(path: string) -> string {
  return clearDir(path)
}

/**
  Clear the contents of a directory safely (alternative name for `clearDir`).
*/
export fn wipe(path: string) -> string {
