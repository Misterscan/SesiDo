/**
  Remove a file or directory with retry logic to ensure resilience.

  Parameters:
  - path: The file or directory path to be removed.

  Returns:
    A string indicating the success or failure of the operation.
*/
export fn remove(path: string) -> string {
  let success = false
  let attempts = 0
  while !success && attempts < 3 {
    try {
      trash(path, true)
      success = true
    } catch (err) {
      attempts = attempts + 1
      Time.sleep(100)
    }
  }
  if success == true {
    return "Successfully deleted " + path
  } else {
    return "Failed to delete " + path
  }
}

