}

/**
  Check if a path is a folder.

  Parameters:
  - path: The path to check.

  Returns:
    A boolean indicating whether the path is a folder (`true`) or not (`false`).
*/
export fn isFolder(path: string) -> bool {
  // If it's a file, return false. If it's a directory, return true. If it doesn't exist, return false.
  try {
    read(path)
  } catch (err) {
    return false
  }
  return dirExists(path)
}

/**
  Create a directory safely with error handling.

  Parameters:
