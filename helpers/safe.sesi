/**
  List the contents of a directory with retry logic to ensure resilience.

  Parameters:
  - path: The directory path to be listed.

  Returns:
    An array of strings representing the contents of the directory. Returns an empty array if the operation fails.
*/
export fn listDir(path: string) -> array<string> {
  let success = false
  let attempts = 0
  while !success && attempts < 3 {
    try {
      return list_dir(path)
    } catch (err) {
      attempts = attempts + 1
      Time.sleep(100)
    }
  }
  return []
}

