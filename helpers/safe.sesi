/**
  Move a file to a new location with retry logic to ensure resilience.

  Parameters:
  - path: The current file path.
  - dest: The destination file path.

  Returns:
    A string indicating the success or failure of the operation.
*/
export fn moveFile(path: string, dest: string) -> string {
  let success = false
  let attempts = 0
  while !success && attempts < 3 {
    try {
      rename(path, dest)
      success = true
    } catch (err) {
      attempts = attempts + 1
      Time.sleep(100)
    }
  }
  if success == true {
    return "Successfully moved " + path + " to " + dest
  } else {
    return "Failed to move " + path + " to " + dest
  }
}

