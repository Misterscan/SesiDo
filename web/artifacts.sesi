/** Artifact discovery uses opaque IDs and rejects symlinks and paths outside the canonical root. */
allow "platform" in as Platform
let root = ""
let index = {}

export fn initialize(path) { root = Platform.metadata(path).path }

fn mime(path) {
  let ext = to_lower(get_ext(path))
  let types = {png: "image/png", jpg: "image/jpeg", jpeg: "image/jpeg", webp: "image/webp", gif: "image/gif", mp4: "video/mp4", wav: "audio/wav", mp3: "audio/mpeg", svg: "image/svg+xml", html: "text/html", htm: "text/html", md: "text/markdown", txt: "text/plain", json: "application/json", sesi: "text/plain", py: "text/plain", js: "text/plain", css: "text/plain"}
  if starts_with(ext, ".") { ext = slice(ext, 1) }
  let value = types[ext]
  if value == null { return "application/octet-stream" }
  return value
}

fn visit(path, found) {
  for entry in list_dir(path) {
    let candidate = path + "/" + entry
    try {
      let info = Platform.metadata(candidate)
      // Canonical equality deliberately excludes symlinks, including directory cycles.
      if info.path == candidate && starts_with(info.path, root + "/") {
        if info.directory { visit(candidate, found) }
        else if info.file {
          let id = Platform.artifactId(slice(info.path, len(root) + 1))
          let item = {id: id, name: entry, path: info.path, size: info.size, modified: info.modified, mime: mime(info.path)}
          index[id] = item
          push(found, item)
        }
      }
    } catch (error) { show "[Web] Skipped unavailable artifact:" candidate }
  }
}

export fn listing() {
  if root == "" { raise_error("ArtifactInitialization", "Initialize the artifact root before listing files.") }
  index = {}
  let found = []
  visit(root, found)
  return found
}

export fn detail(id) {
  listing()
  return index[id]
}

export fn content(id) {
  let item = detail(id)
  if item == null { return {status: 404, body: {error: "Artifact not found."}} }
  if item.size > 67108864 { return {status: 413, body: {error: "File exceeds the 64 MiB web limit. Open it locally: " + item.path}} }
  let attempts = 0
  while attempts < 3 {
    try {
      // Recheck immediately before reading; a replaced link must not escape confinement.
      let info = Platform.metadata(item.path)
      if info.path != item.path || !starts_with(info.path, root + "/") || info.size > 67108864 { raise_error("UnsafeArtifact", "Artifact changed or is outside its root.") }
      let data = Platform.artifactBytes(root, item.path)
      return {status: 200, body: {artifact: item, encoding: "base64", data: data}}
    } catch (error) {
      attempts = attempts + 1
      if attempts == 3 { return {status: 409, body: {error: "Artifact could not be read safely: " + str(error)}} }
    }
  }
}
