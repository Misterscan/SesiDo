{
  "name": "SesiDo",
  "version": "1.3.4",
  "description": "SesiDo - Native Sesi Autonomous Agent",
  "main": "index.sesi",
  "bin": {
    "sesi": "@misterscan/sesi"
  },
  "scripts": {
    "start": "sesi -l main.sesi",
    "mcp": "node agent/mcp/server.mjs",
    "mcp:check": "node --check agent/mcp/server.mjs && node --check agent/mcp/bridge.mjs && sesi -c agent/mcp/dispatch.sesi",
    "mcp:test": "npm run mcp:check && node agent/mcp/smoke-test.mjs",
    "research": "sesi -l agent/ops/research.sesi",
    "browser": "sesi -l agent/ops/browser.sesi",
    "summarize": "sesi -l agent/ops/summarize.sesi",
    "debug": "sesi -l agent/ops/debug.sesi",
    "gen:code": "sesi -l agent/generate/coder.sesi",
    "draw:image": "sesi -l agent/draw/image.sesi",
    "gen:image": "sesi -l agent/generate/image.sesi",
    "gen:video": "sesi -l agent/generate/video.sesi",
    "gen:pixel": "sesi -l agent/generate/pixel-art.sesi",
    "gen:svg": "sesi -l agent/generate/svg.sesi",
    "calculator": "sesi -l agent/math/calculator.sesi"
  },
  "keywords": [
    "ai",
    "sesi",
    "intelligence"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.6"
  }
}
