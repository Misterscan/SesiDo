allow "std/draw" in as Draw
allow "std/math" in as Math

let width = 1280
let height = 800
let sunX = 21
let sunY = 658
let sunR = 224

fn hash(x,y) {
  let h = Math.sin(x*127.1+y*311.7)*43758.5453
  return h-Math.floor(h)
}

fn mix(a,b,t) {
  return [Math.lerp(a[0],b[0],t),Math.lerp(a[1],b[1],t),Math.lerp(a[2],b[2],t)]
}

fn ink(x,y,c) {
  Draw.pixel(x,y,Draw.rgb(c[0],c[1],c[2]))
}

// A split, dusty ribbon of starlight behind the sunlit worlds.
fn sky(x,y) {
  let u = x*0.76+y*0.65
  let v = y*0.76-x*0.65+316
  let bend = v+37*Math.sin(u/193)-21*Math.sin(u/91)
  let knot = Draw.noise(u/127,bend/86,14)
  let lace = Draw.fractal(u/81,bend/44,4,0.55,2.13,33)
  let lane = Math.exp(-Math.pow((bend+11*Math.sin(u/43))/19,2))*Math.clamp((knot-0.18)*2.3)
  let haze = Math.exp(-Math.pow(bend/121,2))*(0.24+0.87*knot)*Math.pow(lace,1.6)*(1-0.75*lane)
  let blue = Math.exp(-Math.pow((bend+62)/167,2))*0.5
  let c = [4+29*haze,6+36*haze+4*blue,14+52*haze+10*blue]
  let ix = Math.floor(x/9)
  let iy = Math.floor(y/9)
  let seed = hash(ix,iy)
  if seed > 0.9-0.12*haze {
    let dx = x-ix*9-2-5*hash(ix+91,iy)
    let dy = y-iy*9-2-5*hash(ix,iy+71)
    let q = hash(ix+47,iy-19)
    let p = Math.exp(-(dx*dx+dy*dy)/(0.26+0.68*q*q))*(27+188*Math.pow(q,4))
    let tint = hash(ix-37,iy+13)
    c = [c[0]+p*(0.76+0.27*tint),c[1]+p*0.91,c[2]+p*(1.08-0.31*tint)]
  }
  let dust = hash(x+101,y+78)
  if dust > 0.995 { c = [c[0]+10+46*haze,c[1]+14+53*haze,c[2]+24+59*haze] }
  let grain = (hash(x-6,y+17)-0.5)*2.5
  return [c[0]+grain,c[1]+grain,c[2]+grain]
}

// Arched prominences rising from the photosphere.
fn prominence(a,h,center,half,peak) {
  let t = (a-center)/half
  if Math.abs(t) >= 1 { return 0 }
  let arch = peak*Math.pow(Math.cos(t*1.570796),1.15)
  let d = h-arch
  let threads = Math.exp(-Math.abs(d)/1.6)+0.38*Math.exp(-Math.abs(d+5+3*Math.sin(t*13))/2.1)
  return threads*(0.58+0.42*Math.pow(Math.sin(t*16+h*0.15),2))
}

fn space(x,y) {
  let c = sky(x,y)
  let dx = x-sunX
  let dy = y-sunY
  let d = Math.sqrt(dx*dx+dy*dy)
  let h = d-sunR
  if h > 400 { return c }
  let a = Math.atan2(dy,dx)
  let edge = Math.clamp(0.5-h)
  let k = Math.max(0,h)
  let flow = Draw.noise(a*15+0.35*Math.sin(k/33+a*4),k/102,80)
  let ray = Draw.noise(a*63+0.19*Math.sin(k/25+a*9),k/149,93)
  let streamer = Math.pow(0.21+flow*0.9,3)*Math.exp(-k/(29+76*flow))*(0.48+ray*0.82)
  let bloom = Math.exp(-k/84)
  let rim = Math.exp(-k/4.4)
  let loop = prominence(a,k,-1.06,0.15,41)+prominence(a,k,-0.39,0.096,25)+0.7*prominence(a,k,0.31,0.12,29)
  c = [c[0]+80*bloom+203*streamer+103*rim+184*loop,c[1]+28*bloom+115*streamer+80*rim+83*loop,c[2]+10*bloom+44*streamer+34*rim+27*loop]
  if edge > 0 {
    let sx = dx/sunR
    let sy = dy/sunR
    let z = Math.sqrt(Math.max(0,1-sx*sx-sy*sy))
    let lon = Math.atan2(sx,z)
    let lat = Math.asin(Math.clamp(sy,-1,1))
    let roll = Draw.fractal(lon*5,lat*6,4,0.56,2,20)
    let cells = Draw.noise(lon*89+roll*5,lat*89,42)
    let mesh = Draw.fractal(lon*27+roll*7,lat*26+roll*8,4,0.59,2.06,63)
    let heat = Math.clamp(0.15+0.56*roll+0.46*mesh+0.24*cells-0.22*Math.pow(1-z,2))
    let spot = Math.exp(-Math.pow((lon-0.48)/0.105,2)-Math.pow((lat+0.31)/0.057,2))
    spot = spot*Math.clamp((mesh-0.28)*2.6)
    let ball = [255-51*spot,95+149*heat-105*spot,24+165*Math.pow(heat,1.6)-25*spot]
    let lip = 0.79*Math.exp(-Math.abs(h)/1.65)
    ball = mix(ball,[255,231,164],lip)
    c = mix(c,ball,edge)
  }
  return c
}

// Soft diffraction on the few brightest field stars.
fn flare(cx,cy,r,warm) {
  let y = cy-r
  while y <= cy+r {
    let x = cx-r
    while x <= cx+r {
      let u = Math.abs(x-cx)
      let v = Math.abs(y-cy)
      let d = Math.sqrt(u*u+v*v)
      if d <= r {
        let f = Math.pow(1-d/r,2)*Math.exp(-Math.min(u,v)*2.9)*0.42+0.83*Math.exp(-d*d/3.6)+0.11*Math.exp(-d/3.2)
        let c = mix(space(x,y),[197+56*warm,224+17*warm,255-49*warm],Math.clamp(f))
        ink(x,y,c)
      }
      x = x+1
    }
    y = y+1
  }
}

fn oval(x,y,cx,cy,rx,ry,tilt) {
  let v = (y-cy)/ry
  let u = (x-cx-(y-cy)*tilt)/rx
  return 1-u*u-v*v
}

// Each texture is evaluated on the visible hemisphere, not on a flat disk.
fn surface(id,x,y,z) {
  let tx = x*0.97+y*0.243
  let ty = y*0.97-x*0.243
  let u = Math.atan2(tx,z)
  let v = Math.asin(Math.clamp(ty,-1,1))
  let n = Draw.fractal(u*5.2,v*5.2,4,0.53,2.1,28+id*13)
  let fine = Draw.noise(u*47,v*47,60+id)
  let c = [160,151,145]
  if id == 1 || id == 4 || id == 9 {
    let lo = [85,76,74]
    let hi = [197,182,165]
    if id == 4 {
      lo = [102,46,32]
      hi = [224,140,91]
    }
    if id == 9 {
      lo = [63,69,87]
      hi = [203,202,190]
    }
    let maria = Draw.noise(u*2.5,v*3.4,83+id)
    let relief = 0
    let craters = [[-0.56,-0.31,0.16],[-0.32,0.4,0.095],[0.16,-0.58,0.13],[0.35,0.14,0.19],[-0.02,0.09,0.071],[0.63,0.44,0.11],[-0.65,0.32,0.061],[0.22,0.53,0.09]]
    for crater in craters {
      let a = (u-crater[0])/crater[2]
      let b = (v-crater[1])/crater[2]
      let d = Math.sqrt(a*a+b*b)
      if d < 1.63 {
        relief = relief+0.26*Math.exp(-Math.pow((d-1)/0.16,2))*(0.24+0.6*a-0.47*b)-0.14*Math.exp(-d*d*2.4)
      }
    }
    let t = Math.clamp(0.03+0.58*n+0.24*fine+0.26*maria+relief)
    c = mix(lo,hi,t)
    if id == 4 {
      let ice = Math.clamp((Math.abs(v)+0.16*n-1.18)*6)
      c = mix(c,[241,216,194],ice*0.9)
    }
  }
  if id == 2 {
    let wind = Draw.fractal(u*2.7+v*2,v*7,5,0.54,2,101)
    let stripe = 0.5+0.5*Math.sin(v*18+u*1.1+wind*4)
    c = mix([166,121,79],[253,224,173],Math.clamp(0.16+0.57*wind+0.18*stripe+0.12*fine))
  }
  if id == 3 {
    let land = oval(u,v,-0.49,-0.31,0.43,0.26,0.33)
    land = Math.max(land,oval(u,v,-0.3,-0.04,0.11,0.20,0.55))
    land = Math.max(land,oval(u,v,-0.08,0.30,0.22,0.40,-0.39))
    land = Math.max(land,oval(u,v,0.80,-0.33,0.48,0.22,0.26))
    land = Math.max(land,oval(u,v,0.60,0.06,0.23,0.34,-0.31))
    let coast = land+(n-0.51)*2.4+(fine-0.5)*0.30
    let sea = mix([12,42,101],[35,123,170],Math.clamp(0.29+0.61*n+0.43*Math.exp(-Math.abs(coast)*9)))
    let dry = Math.clamp(0.13+0.75*Draw.noise(u*3.3,v*2.6,52)+0.24*Math.sin(v*9))
    let ground = mix([47,83,55],[194,151,94],dry)
    c = mix(sea,ground,Math.clamp(coast*8+0.22))
    let drift = Draw.noise(u*3.3,v*3.7,74)
    let wisps = Draw.fractal(u*6+drift*3,v*13+u*2+drift*3,5,0.56,2.07,106)
    let clouds = Math.pow(Math.clamp((wisps-0.45)*3.3),1.28)
    let polar = Math.clamp((Math.abs(v)+0.12*n-1.00)*6)*0.88
    c = mix(c,[230,241,246],Math.max(clouds,polar))
  }
  if id == 5 || id == 6 {
    let jet = Draw.fractal(u*4.1,v*12.5,4,0.56,2.05,171+id)
    let curl = Draw.noise(u*5.5,v*9,111)
    let eu = (u+0.28)/0.31
    let ev = (v-0.24+0.08*(u+0.28))/0.132
    let storm = Math.sqrt(eu*eu+ev*ev)
    let lat = v+0.034*(jet-0.5)+0.016*Math.sin(u*8+curl*5)
    if id == 5 {
      lat = lat+0.092*Math.exp(-storm*storm*0.68)
      let belt = 0.5+0.5*Math.sin(lat*30+0.81*Math.sin(lat*13)+0.19*Math.sin(lat*92))
      let filament = Math.sin(lat*172+jet*6+0.7*Math.sin(u*17+v*7))
      let t = Math.clamp(0.12+0.64*Math.pow(belt,0.77)+0.27*jet+0.066*filament)
      c = mix([120,68,49],[246,222,185],t)
      c = mix(c,[98,124,131],Math.clamp((-0.36-lat)*0.69)*0.47)
      let spiral = 0.5+0.5*Math.sin(storm*17+1.2*Math.atan2(ev,eu)+jet*3)
      let eye = mix([149,61,42],[236,151,105],0.26+0.55*spiral+0.13*n)
      c = mix(c,eye,Math.clamp((1.12-storm)*7)*0.87)
      c = mix(c,[248,212,167],0.36*Math.exp(-Math.pow((storm-1.13)*11,2)))
    } else {
      let bands = 0.5+0.5*Math.sin(lat*25+0.65*Math.sin(lat*57))
      c = mix([151,116,84],[248,222,176],Math.clamp(0.34+0.37*bands+0.29*jet+0.045*Math.sin(lat*181)))
      c = mix(c,[152,163,147],Math.clamp((-v-0.48)*0.83)*0.74)
    }
  }
  if id == 7 {
    let w = v+0.018*Math.sin(u*5+n*3)
    c = mix([71,144,150],[175,222,214],0.45+0.16*Math.sin(w*12)+0.24*n+0.15*Math.clamp(-v))
  }
  if id == 8 {
    let w = v+0.045*Math.sin(u*4+n*2.4)
    let dark = Math.exp(-Math.pow((u+0.36)/0.24,2)-Math.pow((v+0.18)/0.12,2))
    let blue = Math.clamp(0.43+0.17*Math.sin(w*18)+0.37*n-0.27*dark)
    let frost = 0.29*Math.exp(-Math.pow((w-0.36)*16,2))*Math.clamp((fine-0.24)*1.6)
    c = mix(mix([37,61,141],[102,165,222],blue),[187,218,241],frost)
  }
  return c
}

// Shade the globe and project Saturn's annulus through the same image plane.
fn world(cx,cy,r,id,depth) {
  let lx = sunX-cx
  let ly = sunY-cy
  let lens = Math.sqrt(lx*lx+ly*ly)
  lx = lx/lens
  ly = ly/lens
  let side = Math.sqrt(1-depth*depth)
  lx = lx*side
  ly = ly*side
  let extX = r+8
  let extY = r+8
  if id == 6 {
    extX = r*2.4+2
    extY = r*1.2+2
  }
  let y = Math.max(0,Math.floor(cy-extY))
  while y <= Math.min(height-1,cy+extY) {
    let x = Math.max(0,Math.floor(cx-extX))
    while x <= Math.min(width-1,cx+extX) {
      let a = (x-cx)/r
      let b = (y-cy)/r
      let q = a*a+b*b
      let d = Math.sqrt(q)
      let z = Math.sqrt(Math.max(0,1-q))
      let cov = Math.clamp((1-d)*r+0.5)
      let ru = a*0.942-b*0.336
      let rv = a*0.336+b*0.942
      let rr = Math.sqrt(ru*ru+rv*rv/(0.385*0.385))
      let rz = rv*2.397
      let ring = 0
      if id == 6 && rr > 1.26 && rr < 2.39 { ring = 1 }
      let air = 0
      if id >= 2 && id <= 8 && id != 4 && d < 1.13 {
        air = Math.exp(-Math.abs(d-1)*r/1.75)*Math.clamp((a*lx+b*ly+0.14)*1.4)
      }
      if cov > 0 || ring > 0 || air > 0.009 {
        let c = [0,0,0]
        if cov < 1 { c = space(x,y) }
        if cov > 0 {
          let base = surface(id,a,b,z)
          let ndl = a*lx+b*ly+z*depth
          let lit = 0.055+0.97*Math.pow(Math.clamp((ndl+0.048)/1.048),0.66)
          if id == 6 {
            let plane = 0.336*a+0.942*b-z/2.397
            let slope = 0.336*lx+0.942*ly-depth/2.397
            if Math.abs(slope) > 0.001 {
              let t = -plane/slope
              let su = (a+t*lx)*0.942-(b+t*ly)*0.336
              let sv = (a+t*lx)*0.336+(b+t*ly)*0.942
              let sr = Math.sqrt(su*su+sv*sv/(0.385*0.385))
              if t > 0 && sr > 1.34 && sr < 2.31 {
                let shade = Math.clamp(Math.min(sr-1.34,2.31-sr)*33)*0.57
                shade = shade*(1-0.74*Math.exp(-Math.pow((sr-1.96)/0.032,2)))
                lit = lit*(1-shade)
              }
            }
          }
          let rim = air*0.72
          let tint = [159,193,209]
          if id == 3 { tint = [67,172,255] }
          if id == 2 || id == 5 || id == 6 { tint = [246,197,142] }
          let ball = [base[0]*lit+rim*tint[0]*0.43,base[1]*lit+rim*tint[1]*0.51,base[2]*lit+rim*tint[2]*0.76+2]
          c = mix(c,ball,cov)
        }
        let mist = air*(1-cov)
        c = [c[0]+mist*20,c[1]+mist*39,c[2]+mist*55]
        if ring > 0 && (cov < 1 || rz > z) {
          let band = Draw.noise(rr*43,12,161)*0.28+0.12*Math.sin(rr*231)+0.085*Math.sin(rr*460)
          let main = Math.exp(-Math.pow((rr-1.71)/0.26,2))
          let division = Math.exp(-Math.pow((rr-1.963)/0.029,2))+0.54*Math.exp(-Math.pow((rr-2.244)/0.014,2))
          let edge = Math.clamp(Math.min(rr-1.26,2.39-rr)*57)
          let opacity = Math.clamp((0.42+0.45*main+band)*(1-0.94*division))*edge
          let ringC = mix([120,111,104],[240,211,165],Math.clamp(0.33+0.52*main+band))
          let along = a*lx+b*ly+rz*depth
          let closest = rr*rr-along*along
          let shade = 1
          if along < 0 { shade = 0.15+0.85*Math.clamp((closest-0.91)*6) }
          c = mix(c,[ringC[0]*shade,ringC[1]*shade,ringC[2]*shade+2],opacity)
        }
        ink(x,y,c)
      }
      x = x+1
    }
    y = y+1
  }
}

Draw.clear()
let y = 0
while y < height {
  let x = 0
  while x < width {
    ink(x,y,space(x,y))
    x = x+1
  }
  y = y+1
}
flare(156,161,16,0.12)
flare(529,118,10,0.9)
flare(799,197,11,0.32)
flare(1062,78,8,0.37)
flare(1202,465,13,0.08)
flare(881,689,8,0.68)
flare(350,671,7,0.55)

world(1175,122,45,8,0.64)
world(1115,594,51,7,0.67)
world(995,302,91,6,0.52)
world(680,429,144,5,0.52)
world(489,244,13,9,0.45)
world(422,340,62,3,0.57)
world(493,600,29,4,0.44)
world(310,491,34,2,0.47)
world(278,628,13,1,0.43)
Draw.save_png("The_Solar_System.png",1280,800,"#04060e")