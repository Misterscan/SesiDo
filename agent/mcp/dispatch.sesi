/**
  Non-interactive SesiDo entry point for the MCP server.

  Arguments are ordinary Sesi CLI arguments:
    args[0] = action
    args[1...] = action-specific values

  The final marked JSON object is consumed by bridge.mjs. All normal SesiDo
  logging before that marker is captured as diagnostic output by the bridge.
*/
allow "helpers/safe" in as Safe
allow "../../build/index" in as SesiDo

// Set model aliases for agents invoked via MCP dispatch
set_alias("SesiDo", "gemini-3.7-flash")
set_alias("SesiDo-Exp", "gemini-3.6-flash")
set_alias("SesiDo-Pro", "gemini-3.1-pro-preview")
set_alias("SesiDo-Lite", "gemini-3.1-flash-lite")
set_alias("SesiDo-Lite-Power", "gemini-3.5-flash-lite")
set_alias("SesiDo-Flash", "gemini-3-flash-preview")
set_alias("SesiDo-Image", "gemini-3.1-flash-image")
set_alias("SesiDo-Image-Lite", "gemini-3.1-flash-lite-image")
set_alias("SesiDo-Video", "veo-3.1-lite-generate-preview")
set_alias("SesiDo-GPT", "gpt-5.6-terra")
set_alias("SesiDo-GPT-Pro", "gpt-5.6-sol")
set_alias("SesiDo-GPT-Lite", "gpt-5.6-luna")
set_alias("SesiDo-GPT-Image", "gpt-image-2")

let resultPrefix = "__SESIDO_MCP_RESULT__="
let action = ""
let result = ""
let task = null

fn summarizeFile(path) {
    let source = Safe.read(path)
    return SesiDo.summarize({"text": source})
}

fn isFailure(value) {
    let message = to_lower(trim(str(value)))
    return starts_with(message, "error") || starts_with(message, "execution error") || starts_with(message, "failed") || starts_with(message, "code generation failed") || starts_with(message, "research failed") || starts_with(message, "summarization failed") || starts_with(message, "model request failed") || starts_with(message, "browser operation failed") || starts_with(message, "no file specified") || starts_with(message, "no text provided") || starts_with(message, "not enough page content")
}

if len(args) > 0 {
    action = args[0]
}

try {
    if action == "write_code" {
        if len(args) < 2 {
            result = "Error: write_code requires a query."
        } else {
            task = lazy(SesiDo.writeCode, {"query": args[1]})
        }
    } else if action == "debug_code" {
        if len(args) < 2 {
            result = "Error: debug_code requires a path."
        } else {
            task = lazy(SesiDo.debugCode, {"path": args[1]})
        }
    } else if action == "research" {
        if len(args) < 2 {
            result = "Error: research requires a query."
        } else {
            task = lazy(SesiDo.research, {"query": args[1]})
        }
    } else if action == "summarize_text" {
        if len(args) < 2 {
            result = "Error: summarize_text requires text."
        } else {
            task = lazy(SesiDo.summarize, {"text": args[1]})
        }
    } else if action == "summarize_file" {
        if len(args) < 2 {
            result = "Error: summarize_file requires a path."
        } else {
            task = lazy(summarizeFile, args[1])
        }
    } else if action == "calculate" {
        if len(args) < 2 {
            result = "Error: calculate requires an expression."
        } else {
            task = lazy(SesiDo.calculator, {"expression": args[1]})
        }
    } else if action == "create_svg" {
        if len(args) < 2 {
            result = "Error: create_svg requires a description."
        } else {
            task = lazy(SesiDo.createSVG, {"description": args[1]})
        }
    } else if action == "draw_pixel_art" {
        if len(args) < 2 {
            result = "Error: draw_pixel_art requires a description."
        } else {
            task = lazy(SesiDo.drawPixelArt, {"description": args[1]})
        }
    } else if action == "draw_image" {
        if len(args) < 2 {
            result = "Error: draw_image requires a description."
        } else {
            task = lazy(SesiDo.drawImage, {"description": args[1]})
        }
    } else if action == "generate_image" {
        if len(args) < 2 {
            result = "Error: generate_image requires a prompt."
        } else {
            task = lazy(SesiDo.generateImage, {"query": args[1]})
        }
    } else if action == "generate_video" {
        if len(args) < 4 {
            result = "Error: generate_video requires a prompt, duration, and negative prompt."
        } else {
            task = lazy(SesiDo.generateVideo, {
                "query": args[1],
                "duration": num(args[2]),
                "negative": args[3]
            })
        }
    } else if action == "inspect_image" {
        if len(args) < 2 {
            result = "Error: inspect_image requires a path."
        } else {
            task = lazy(SesiDo.getImageInfo, {"path": args[1]})
        }
    } else if action == "browse_page" {
        if len(args) < 3 {
            result = "Error: browse_page requires a URL and operation."
        } else {
            task = lazy(SesiDo.browsePage, {
                "url": args[1],
                "operation": args[2]
            })
        }
    } else {
        result = "Error: Unknown SesiDo MCP action: " + action
    }

    if !is_null(task) {
        result = force(task)
    }
} catch (err) {
    result = "Error: " + str(err)
}

let envelope = {
    "ok": !isFailure(result),
    "action": action,
    "result": str(result)
}

show resultPrefix + to_json(envelope)
