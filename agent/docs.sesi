// SesiDo Doc Retrieval
// Import safe functions and define directories
allow "../utils/safe" in as Safe; let basicsDir = list_dir("getting-started/"); if is_null(basicsDir) {basicsDir = list_dir("sesi_modules/SesiDo/docs/getting-started")} let optionalDir = list_dir("getting-started/optional"); if is_null(optionalDir) {optionalDir = list_dir("sesi_modules/SesiDo/docs/getting-started/optional")} let otherDir = ["SPECIFICATION.md", "WRITING_SCRIPTS.md"]
export fn getBasicsContent() -> string {let content = ""; for file in basicsDir {if contains(file, "optional") { continue } let text = Safe.readFile("getting-started/" + file); if text == "" { text = Safe.readFile("sesi_modules/SesiDo/docs/getting-started/" + file) } if text != "" { content = content + "\n--- " + file + " ---\n" + text }} return content}
// Get getting-started-optional content
export fn getOptionalContent() -> string {let content = ""; for file in optionalDir { let text = Safe.readFile("getting-started/optional/" + file); if text == "" { text = Safe.readFile("sesi_modules/SesiDo/docs/getting-started/optional/" + file) } if text != "" { content = content + "\n--- " + file + " ---\n" + text }} return content}
// Get WRITING_SCRIPTS and SPECIFICATION content
export fn getOtherContent() -> string {let content = ""; for file in otherDir { let text = Safe.readFile("docs/" + file); if text == "" { text = Safe.readFile("sesi_modules/SesiDo/docs/" + file) } if text != "" { content = content + "\n--- " + file + " ---\n" + text } } return content}