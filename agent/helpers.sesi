// SesiDo Helper Retrieval
allow "../utils/safe" in as Safe; let helpersDir = list_dir("helpers/"); if helpersDir == null {helpersDir = list_dir("sesi_modules/SesiDo/helpers")}
// Get helper scripts
export fn getHelperContent() -> string {let content = ""; let ext = ""; let text = ""; for file in helpersDir { ext = get_ext(file); if ext == "sesi" { text = Safe.readFile("helpers/" + file); if text == "" { text = Safe.readFile("sesi_modules/SesiDo/helpers/" + file) } if text != "" { content = content + "\n--- " + file + " ---\n" + text }} return content} }