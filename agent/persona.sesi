// SesiDo Persona Retrieval
// Import safe functions, docs, and helpers
allow "../utils/safe" in as Safe; allow "./docs" in as Docs; allow "./helpers" in as Helpers
// Load persona components
let sysPath = "sesi_modules/SesiDo/database/.agent/SYSTEM_INSTRUCTION.md"; let toolsPath = "sesi_modules/SesiDo/database/.agent/tools.md"
let systemInstruction = Safe.readFile(sysPath); let toolsMD = Safe.readFile(toolsPath); if systemInstruction == null || trim(systemInstruction) == "" { sysPath = "database/.agent/SYSTEM_INSTRUCTION.md"; systemInstruction = Safe.readFile(sysPath) }if toolsMD == null || trim(toolsMD) == "" { toolsPath = "database/.agent/tools.md"; toolsMD = Safe.readFile(toolsPath) }
let agentTools = Helpers.getHelperContent(); let agentBasicsMD = Docs.getBasicsContent(); let agentOptionalMD = Docs.getOptionalContent(); let agentOtherMD = Docs.getOtherContent()
// Export persona components
export fn getSystemInstruction() -> string {return systemInstruction}
export fn getToolsMD() -> string {return toolsMD}
export fn getAgentBasicsMD() -> string {return agentBasicsMD}
export fn getAgentOptionalMD() -> string {return agentOptionalMD}
export fn getAgentOtherMD() -> string {return agentOtherMD}
export fn getAgentTools() -> string {return agentTools}

/**
  Agent voice management.

  Fields:
  - `active`: Indicates if the voice mode is active.
  - `voiceOn`: Indicates if the voice is currently on.

  Functions:
  - `start(choice)`: Starts the voice mode with the given choice (`true` to enable, `false` to disable).
  - `response(message)`: Handles the agent's voice response based on the current voice mode status.

  Returns:
  - None.
*/
make AgentVoice {
    let active = false
    let voiceOn = false

    // Starts the voice mode with the given choice.
    //
    // Parameters:
    // - `choice`: A boolean indicating whether to start the voice mode (true) or not (false).
    //
    // Returns:
    // - None.
    fn start(self, choice) {
        self.voiceOn = choice == true
        if self.voiceOn {
            speech("Hello, I am Sey-see Do, your AI agent. How can I assist you today?")
        } else {
            show "[SesiDo]: Voice mode is disabled."
        }
    }

    // Handles the agent's voice response.
    //
    // Parameters:
    // - `message`: The message to be spoken by the agent.
    //
    // Returns:
    // - None.
    fn response(self, message) {
        if self.voiceOn {
            show "[SesiDo]: Speaking response:" message
            speech(message)
        } else {
            show "[SesiDo]: Voice mode is disabled. Not speaking."
        }
    }
}