Draw.pixel_polygon([[391,443],[505,443],[1200,730],[1200,800],[1111,800]], palette.sunlightSoft)
// Restore the tile joints across the sunlit floor.
let joint = 0
while joint <= 13 {
  let a = surfacePoint(floorCorners, joint / 13, 0)
  let b = surfacePoint(floorCorners, joint / 13, 1)
  Draw.pixel_line(a[0], a[1], b[0], b[1], palette.sunSeam)
  joint = joint + 1
}
joint = 0
while joint <= 8 {
  let a = surfacePoint(floorCorners, 0, joint / 8)
  let b = surfacePoint(floorCorners, 1, joint / 8)
  Draw.pixel_line(a[0], a[1], b[0], b[1], palette.sunSeam)
  joint = joint + 1
}
// The unplugged vending machine: dark display, no illuminated controls.
