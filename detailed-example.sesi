Draw.clear()
Draw.pixel_rect(0, 0, width, height, palette.background)
// Interpolate a point inside a quadrilateral, using normalized coordinates.
fn surfacePoint(corners: array, u: number, v: number) -> array {
  let topX = corners[0][0] + (corners[1][0] - corners[0][0]) * u
  let topY = corners[0][1] + (corners[1][1] - corners[0][1]) * u
  let bottomX = corners[3][0] + (corners[2][0] - corners[3][0]) * u
  let bottomY = corners[3][1] + (corners[2][1] - corners[3][1]) * u
  return [topX + (bottomX - topX) * v, topY + (bottomY - topY) * v]
}
// Draw the floor as a perspective grid of inset ceramic tiles.
fn tiledFloor(corners: array, columns: number, rows: number) {
  let cellInsetX = 0.0015
  let cellInsetY = 0.003
  let row = 0
  while row < rows {
    let column = 0
    while column < columns {
      let u0 = column / columns + cellInsetX
      let u1 = (column + 1) / columns - cellInsetX
      let v0 = row / rows + cellInsetY
      let v1 = (row + 1) / rows - cellInsetY
      let color = palette.tileA
      if (column + row) % 2 == 0 { color = palette.tileB }
      Draw.pixel_polygon([surfacePoint(corners, u0, v0), surfacePoint(corners, u1, v0), surfacePoint(corners, u1, v1), surfacePoint(corners, u0, v1)], color, true)
      column = column + 1
    }
    row = row + 1
  }
}
// Draw a running front-loading washer at a supplied position and scale.
fn washer(x: number, y: number, scale: number, phase: number) {
  Draw.pixel_rect(x + 7 * scale, y + 7 * scale, 159 * scale, 160 * scale, palette.deepShadow)
  Draw.pixel_rect(x, y, 160 * scale, 156 * scale, palette.metalShade)
  Draw.pixel_rect(x + 4 * scale, y + 4 * scale, 152 * scale, 143 * scale, palette.metalLight)
  Draw.pixel_rect(x + 6 * scale, y + 5 * scale, 148 * scale, 29 * scale, palette.metal)
  Draw.pixel_rect(x + 14 * scale, y + 13 * scale, 40 * scale, 10 * scale, palette.white)
  Draw.pixel_line(x + 15 * scale, y + 25 * scale, x + 55 * scale, y + 25 * scale, palette.metalShade)
  Draw.pixel_circle(x + 116 * scale, y + 18 * scale, 8 * scale, palette.metalShade)
  Draw.pixel_circle(x + 116 * scale, y + 18 * scale, 5 * scale, palette.white)
  Draw.pixel_rect(x + 69 * scale, y + 12 * scale, 27 * scale, 13 * scale, palette.glassDark)
  Draw.pixel_rect(x + 74 * scale, y + 16 * scale, 13 * scale, 3 * scale, palette.water)
  Draw.pixel_circle(x + 80 * scale, y + 90 * scale, 52 * scale, palette.metalShade)
  Draw.pixel_circle(x + 80 * scale, y + 89 * scale, 47 * scale, palette.white)
  Draw.pixel_circle(x + 80 * scale, y + 90 * scale, 40 * scale, palette.glassDark)
  Draw.pixel_circle(x + 79 * scale, y + 89 * scale, 34 * scale, palette.glass)
  Draw.pixel_ellipse(x + 80 * scale, y + 108 * scale, 29 * scale, 13 * scale, palette.water)
  let angle = phase
  let i = 0
  while i < 4 {
    let px = x + (80 + Math.cos(angle) * 19) * scale
    let py = y + (90 + Math.sin(angle) * 19) * scale
    let laundryColor = palette.foam
    if i % 2 == 0 { laundryColor = palette.blueLaundry }
    Draw.pixel_ellipse(px, py, 15 * scale, 9 * scale, laundryColor)
    angle = angle + Math.PI / 2
    i = i + 1
  }
  Draw.pixel_arc(x + 80 * scale, y + 90 * scale, 31 * scale, 195, 278, palette.metalLight)
  Draw.pixel_arc(x + 80 * scale, y + 90 * scale, 27 * scale, 20, 100, palette.water)
  Draw.pixel_ellipse(x + 64 * scale, y + 70 * scale, 5 * scale, 12 * scale, palette.foam)
  Draw.pixel_rect(x + 122 * scale, y + 82 * scale, 8 * scale, 19 * scale, palette.metalShade)
  Draw.pixel_rect(x + 15 * scale, y + 149 * scale, 130 * scale, 7 * scale, palette.metalShade)
}
// Draw a molded plastic chair in sideways profile, facing left.
fn sidewaysChair(x: number, y: number, scale: number) {
  Draw.pixel_polygon([[x - 52 * scale, y + 84 * scale],[x + 22 * scale, y + 71 * scale],[x + 69 * scale, y + 85 * scale],[x - 13 * scale, y + 109 * scale]], palette.shadow)
  Draw.pixel_polygon([[x - 34 * scale, y - 8 * scale],[x - 24 * scale, y - 8 * scale],[x - 42 * scale, y + 86 * scale],[x - 49 * scale, y + 87 * scale]], palette.chair)
  Draw.pixel_polygon([[x + 22 * scale, y - 10 * scale],[x + 31 * scale, y - 10 * scale],[x + 50 * scale, y + 77 * scale],[x + 43 * scale, y + 79 * scale]], palette.chair)
  Draw.pixel_polygon([[x - 54 * scale, y - 22 * scale],[x + 22 * scale, y - 32 * scale],[x + 42 * scale, y - 10 * scale],[x - 40 * scale, y + 1 * scale]], palette.chairLight)
  Draw.pixel_polygon([[x - 40 * scale, y + 1 * scale],[x + 42 * scale, y - 10 * scale],[x + 40 * scale, y + 1 * scale],[x - 38 * scale, y + 10 * scale]], palette.chair)
  Draw.pixel_polygon([[x + 20 * scale, y - 31 * scale],[x + 9 * scale, y - 113 * scale],[x + 18 * scale, y - 124 * scale],[x + 42 * scale, y - 116 * scale],[x + 51 * scale, y - 37 * scale],[x + 42 * scale, y - 10 * scale]], palette.chair)
  Draw.pixel_line(x + 18 * scale, y - 113 * scale, x + 31 * scale, y - 38 * scale, palette.chairLight)
  Draw.pixel_line(x + 25 * scale, y - 111 * scale, x + 38 * scale, y - 39 * scale, palette.chairLight)
}
