while basketRow < 3 {
  let basketColumn = 0
  while basketColumn < 8 {
    let bx = 438 + basketColumn * 15 + basketRow * 2
    let by = 687 + basketRow * 14 - basketColumn * 1.05
    Draw.pixel_polygon([[bx,by],[bx+9,by-1],[bx+8,by+7],[bx+1,by+8]], palette.basketHole)
    basketColumn = basketColumn + 1
  }
  basketRow = basketRow + 1
}
