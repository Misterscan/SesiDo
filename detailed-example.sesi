  [192,409,1],[302,451,1],[359,478,2],[403,498,1]
]
let dustIndex = 0
while dustIndex < len(dustPoints) {
  let mote = dustPoints[dustIndex]
  Draw.pixel_circle(mote[0], mote[1], mote[2], palette.dust)
  dustIndex = dustIndex + 1
}
try {
  Draw.save_png(output, width, height, palette.background)
  show "Drawing of a laundromat at" width "x" height "saved to" output
} catch (e) { show e }