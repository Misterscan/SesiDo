    Draw.pixel_rect(598 + snack * 21, 234 + shelf * 34, 13, 21, packetColor)
    Draw.pixel_rect(600 + snack * 21, 242 + shelf * 34, 9, 5, palette.machine)
    snack = snack + 1
  }
  Draw.pixel_line(592, 259 + shelf * 34, 665, 259 + shelf * 34, palette.metalShade)
  shelf = shelf + 1
}
